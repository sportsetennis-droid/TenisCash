model AIApproval {
  id              String    @id @default(cuid())
  orchestrationId String?
  type            String // discount, whatsapp_bulk, paid_campaign, stock_purchase, balance_change, etc.
  title           String
  description     String?
  riskLevel       String    @default("medium") // low, medium, high
  status          String    @default("pending") // pending, approved, rejected, correction_requested, executed, cancelled
  payload         Json?
  approvedById    String?
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orchestration AIOrchestration? @relation(fields: [orchestrationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, status])
}

model AILog {
  id          String   @id @default(cuid())
  agentCode   String
  action      String
  input       Json?
  output      Json?
  error       String?
  cost        Float?
  tokens      Int?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([agentCode, createdAt])
  @@index([createdAt])
}

// =====================================================================
// Memória da Empresa — o "cérebro" persistente que a IA lê antes de agir.
// Guarda DUAS coisas numa só tabela:
//   - kind="fact"  → o que a empresa É (lojas, marcas, regras, metas).
//                    Geralmente pinned=true: a IA SEMPRE lê.
//   - kind="event" → o que ACONTECE (venda, estoque, campanha, decisão,
//                    conversa com a IA). Linha do tempo, gravada pra sempre.
// =====================================================================
model CompanyMemory {
  id          String   @id @default(cuid())
  kind        String   @default("event") // "fact" | "event"
  category    String   @default("geral") // venda, estoque, financeiro, cliente, campanha, decisao, ia, nota, empresa, fornecedor, meta...
  title       String
  detail      String? // texto legível (pra humano e pra IA)
  data        Json? // payload estruturado opcional
  company     String?  @default("Sports & Tennis")
  source      String   @default("manual") // manual, orchestrator, approval, sales, stock, system...
  refType     String? // tipo do registro de origem (ex: "AIOrchestration")
  refId       String? // id do registro de origem
  importance  Int      @default(1) // 0=baixa 1=normal 2=alta 3=crítica — prioriza o que a IA lembra
  pinned      Boolean  @default(false) // fato fixo que a IA sempre carrega
  createdById String?
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([category, createdAt])
  @@index([company, createdAt])
  @@index([refType, refId])
}

