// XML NF-e (importação fiscal)
// ============================================================

model XmlExportJob {
  id            String    @id @default(cuid())
  name          String
  type          String // FULL_BACKUP | PRODUCTS | INVENTORY | CUSTOMERS | SALES | FINANCE | SUPPLIERS | CAMPAIGNS | CURATION | SELLER_PORTFOLIO | SELLER_INTERVIEWS | NUVEMSHOP | LABELS | TENISCASH
  module        String?
  status        String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  requestedById String?
  storeId       String?
  dateFrom      DateTime?
  dateTo        DateTime?
  filters       Json?
  totalRecords  Int       @default(0)
  fileUrl       String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  errorMessage  String?

  @@index([status, createdAt])
}

model XmlImportJob {
  id                      String    @id @default(cuid())
  name                    String
  type                    String // NFE_ENTRY | PRODUCTS | INVENTORY | CUSTOMERS | SALES | SUPPLIERS
  status                  String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  uploadedById            String?
  fileUrl                 String?
  originalFileName        String?
  totalItems              Int       @default(0)
  processedItems          Int       @default(0)
  createdProducts         Int       @default(0)
  updatedProducts         Int       @default(0)
  createdInventoryEntries Int       @default(0)
  errorMessage            String?
  createdAt               DateTime  @default(now())
  completedAt             DateTime?

  fiscalDocuments XmlFiscalDocument[]

  @@index([status, createdAt])
  @@index([type])
}

model XmlFiscalDocument {
  id             String    @id @default(cuid())
  importJobId    String?
  accessKey      String?   @unique
  number         String?
  series         String?
  issuerCnpj     String?
  issuerName     String?
  recipientCnpj  String?
  issueDate      DateTime?
  totalValue     Float?
  icmsValue      Float?
  icmsStValue    Float?
  fcpValue       Float?
  fcpStValue     Float?
  difalDestValue Float?
  ipiValue       Float?
  pisValue       Float?
  cofinsValue    Float?
  cbsValue       Float?
  ibsValue       Float?
  rawXmlUrl      String?
  supplierId     String?
  // Marca atribuída a esta NF inteira — usado quando o fornecedor vende
  // múltiplas marcas (ex: Drastosa vende ASICS e PUMA). Operador atribui
  // manualmente no admin; novas importações usam essa info pra rotular
  // produtos automaticamente.
  brand          String?
  brandSetById   String? // userId que atribuiu
  brandSetAt     DateTime?
  // Tipo da NFe: 'entrada' (compra de fornecedor), 'saida' (venda),
  // 'transferencia' (matriz↔filial do mesmo grupo CNPJ raiz)
  docType        String? // entrada | saida | transferencia
  recipientName  String? // nome do destinatário (pra mostrar na lista)
  status         String    @default("imported") // imported | matched | partial | rejected
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  importJob XmlImportJob?   @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  items     XmlFiscalItem[]

  @@index([supplierId])
  @@index([supplierId, brand])
  @@index([status, issueDate])
}

model XmlFiscalItem {
  id               String   @id @default(cuid())
  fiscalDocumentId String
  productId        String?
  supplierCode     String?
  description      String
  ean              String?
  ncm              String?
  cfop             String?
  cst              String?
  unit             String?
  quantity         Float    @default(0)
  unitValue        Float    @default(0)
  totalValue       Float    @default(0)
  icmsBase         Float?
  icmsValue        Float?
  icmsStValue      Float?
  fcpValue         Float?
  fcpStValue       Float?
  difalDestValue   Float?
  ipiValue         Float?
  pisCst           String?
  pisBase          Float?
  pisValue         Float?
  cofinsCst        String?
  cofinsBase       Float?
  cofinsValue      Float?
  cbsValue         Float?
  ibsValue         Float?
  matchStatus      String   @default("pending") // pending | matched | new_product | ignored
  createdAt        DateTime @default(now())

  fiscalDocument XmlFiscalDocument @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)

  @@index([fiscalDocumentId])
  @@index([productId])
}

