  venueId       String
  packageId     String
  clientUserId  String?
  customerName  String?
  customerPhone String?
  sessionsTotal Int
  sessionsUsed  Int                 @default(0)
  pricePaid     Float
  expiresAt     DateTime?
  status        String              @default("active")
  createdAt     DateTime            @default(now())
  package       ServicePackage      @relation(fields: [packageId], references: [id])
  uses          PackageSessionUse[]

  @@index([venueId])
  @@index([packageId])
  @@index([clientUserId])
}

model PackageSessionUse {
  id            String          @id @default(cuid())
  purchaseId    String
  appointmentId String?
  usedAt        DateTime        @default(now())
  purchase      PackagePurchase @relation(fields: [purchaseId], references: [id])

  @@index([purchaseId])
}

model StaffAdvance {
  id             String    @id @default(cuid())
  venueId        String
  professionalId String
  amount         Float
  note           String?
  status         String    @default("open")
  createdAt      DateTime  @default(now())
  paidAt         DateTime?

  @@index([venueId])
  @@index([venueId, status])
  @@index([professionalId])
}

model Payable {
  id          String    @id @default(cuid())
  venueId     String
  description String
  amount      Float
  dueDate     DateTime?
  category    String?
  supplier    String?
  status      String    @default("open")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([venueId])
  @@index([venueId, status])
}

model Receivable {
  id          String    @id @default(cuid())
  venueId     String
  description String
  amount      Float
  dueDate     DateTime?
  clientName  String?
  status      String    @default("open")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([venueId])
  @@index([venueId, status])
}

model StockMovement {
  id             String   @id @default(cuid())
  venueId        String
  venueProductId String
  type           String
  qty            Int
  reason         String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([venueId, createdAt])
  @@index([venueProductId])
}

model MarketingCampaign {
  id        String       @id @default(cuid())
  venueId   String
  type      String
  title     String
  message   String
  segment   String?
  status    String       @default("draft")
  createdAt DateTime     @default(now())
  logs      MessageLog[]

  @@index([venueId])
}

model MessageLog {
  id            String             @id @default(cuid())
  venueId       String
  campaignId    String?
  clientUserId  String?
  customerName  String?
  customerPhone String?
  channel       String             @default("whatsapp")
  status        String             @default("queued")
  createdAt     DateTime           @default(now())
  campaign      MarketingCampaign? @relation(fields: [campaignId], references: [id])

  @@index([venueId])
  @@index([campaignId])
}

model ServiceClubTier {
  id          String                  @id @default(cuid())
  venueId     String
  name        String
  monthlyFee  Float                   @default(0)
  discountPct Float                   @default(0)
  benefits    String?
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  memberships ServiceClubMembership[]

  @@index([venueId])
}

model ServiceClubMembership {
  id            String          @id @default(cuid())
  venueId       String
  tierId        String
  clientUserId  String?
  customerName  String?
  customerPhone String?
  since         DateTime        @default(now())
  status        String          @default("active")
  tier          ServiceClubTier @relation(fields: [tierId], references: [id])

  @@index([venueId])
  @@index([tierId])
}

// ============================================================
// LIVE COMMERCE — vitrine ao vivo + chat de atendimento
// O visitante é ANÔNIMO (não é User), por isso usa modelos
// dedicados em vez de Conversation/ChatMessage (que exigem
// senderId FK de User). storeId/sellerId ficam como String
// solto DE PROPÓSITO: sem FK em Store/User, o `prisma db push`
// é 100% aditivo (cria 3 tabelas novas, zero risco nas
// tabelas de produção existentes).
// ============================================================

model LiveChannel {
  id        String    @id @default(cuid())
  storeId   String    @unique // FK lógica → Store.id (1 canal por loja)
  isLive    Boolean   @default(false)
  title     String? // ex: "Loja Bessa ao vivo — novidades de tênis"
  hlsUrl    String? // player público (Cloudflare Tunnel → MediaMTX da loja)
  startedAt DateTime?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
}

model LiveChat {
  id               String   @id @default(cuid())
  storeId          String // FK lógica → Store.id
  visitorName      String
  visitorToken     String   @unique // segredo do visitante anônimo (substitui login)
  status           String   @default("open") // open | closed
  assignedSellerId String? // FK lógica → User.id (vendedor que assumiu)
  sellerUnread     Int      @default(0) // msgs do visitante não lidas pelo vendedor
  lastMessageAt    DateTime @default(now())
  createdAt        DateTime @default(now())

  messages LiveMessage[]

  @@index([storeId, status, lastMessageAt])
}

model LiveMessage {
  id        String   @id @default(cuid())
  chatId    String
  sender    String // visitor | seller | system
  body      String   @db.Text
  sellerId  String? // FK lógica → User.id quando sender=seller
  createdAt DateTime @default(now())

  chat LiveChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

// ============================================================
// INFOPRODUTOS — plataforma estilo Hotmart dentro do TenisCash
// Produtor (Professional) vende cursos/ebooks/comunidade/mentoria.
// Aluno compra no checkout (Pix/cartão/boleto), acessa área de
// membros, acompanha progresso, ganha certificado. Afiliados
// indicam por link rastreado e ganham comissão. Split, take rate
// e cashback TenisCash entram quando o PSP (Asaas) for ligado;
// até lá o checkout roda em Pix off-platform (dinheiro direto na
// conta do produtor). prisma db push 100% aditivo (14 tabelas).
// ============================================================

model DigitalProduct {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])

  slug        String  @unique // /pd/<slug>, /pay/<slug>
  title       String
  subtitle    String?
  description String? @db.Text
  coverUrl    String?
  type        String  @default("course") // course | ebook | community | mentorship | file | bundle

  // Preço
  price        Float   @default(0)
  comparePrice Float? // preço "de" (riscado)
  currency     String  @default("BRL")
  recurrence   String? // null = vitalício | monthly | annual

  // Entrega
  hasMembersArea Boolean @default(true) // gera área de membros (curso)
  fileUrl        String? // entrega de ebook/arquivo
  accessDays     Int? // dias de acesso após compra (null = vitalício)

  // Checkout
  allowPix        Boolean @default(true)
  allowCard       Boolean @default(true)
  allowBoleto     Boolean @default(false)
  installmentsMax Int     @default(12)

  // Afiliados
  affiliateEnabled       Boolean @default(false)
  affiliateCommissionPct Float   @default(30) // % pro afiliado
  affiliateAutoApprove   Boolean @default(true)
  affiliateCookieDays    Int     @default(30) // janela de atribuição (LCC)

  // Plataforma (entra com PSP)
  platformFeePct Float @default(0) // take rate S&T (0 enquanto off-platform)
  cashbackPct    Float @default(0) // cashback TenisCash pro comprador

  // Garantia/reembolso
  guaranteeDays Int @default(7)

  // Status
  status  String  @default("draft") // draft | published | archived
  visible Boolean @default(true)

  // Stats
  salesCount   Int   @default(0)
  revenueTotal Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules        CourseModule[]
  enrollments    Enrollment[]
  sales          DigitalSale[]
  affiliateLinks AffiliateLink[]
  coproducers    Coproducer[]
  certificates   Certificate[]

  @@index([professionalId])
  @@index([status])
  @@index([type])
}

model CourseModule {
  id        String         @id @default(cuid())
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([productId])
}

model Lesson {
  id       String       @id @default(cuid())
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  order       Int     @default(0)

  videoUrl      String? // YouTube/Vimeo/HLS/MP4
  videoProvider String? // youtube | vimeo | url
  durationSec   Int?
  contentHtml   String? @db.Text // texto rico complementar
  attachmentUrl String?

  free Boolean @default(false) // aula de amostra grátis

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress LessonProgress[]

  @@index([moduleId])
}

model Enrollment {
  id        String         @id @default(cuid())
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id])

  // Comprador pode ou não ser User TenisCash
  userId     String?
  user       User?   @relation("infoEnrollments", fields: [userId], references: [id])
  buyerName  String
  buyerEmail String?
  buyerPhone String?

  saleId      String? // venda que liberou o acesso
  affiliateId String? // quem indicou

  accessToken String @unique // /membros?t=<token> sem login

  status    String    @default("active") // active | refunded | cancelled | expired
  expiresAt DateTime?

  progressPct       Float     @default(0)
  completedAt       DateTime?
  certificateIssued Boolean   @default(false)
  lastAccessAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonProgress LessonProgress[]
  certificate    Certificate?

  @@index([productId])
  @@index([userId])
  @@index([status])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completed   Boolean   @default(false)
  watchedSec  Int       @default(0)
  completedAt DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
}

model Certificate {
  id           String         @id @default(cuid())
  enrollmentId String         @unique
  enrollment   Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  productId    String
  product      DigitalProduct @relation(fields: [productId], references: [id])

  code          String   @unique // /cert/<code> verificação pública
  recipientName String
  courseTitle   String
  hours         Float?
  issuedAt      DateTime @default(now())

  @@index([productId])
}

model Affiliate {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation("infoAffiliate", fields: [userId], references: [id])

  name  String
  email String?
  phone String?

  // Recebimento de comissão
  pixKey        String?
  asaasWalletId String? // recebedor no PSP (split ao vivo)

  status String @default("active") // active | blocked

  // Stats
  clicksTotal       Int   @default(0)
  salesTotal        Int   @default(0)
  commissionTotal   Float @default(0)
  commissionPaid    Float @default(0)
  commissionPending Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links       AffiliateLink[]
  clicks      AffiliateClick[]
  commissions AffiliateCommission[]
  payouts     Payout[]

  @@index([status])
}

model AffiliateLink {
  id          String         @id @default(cuid())
  affiliateId String
  affiliate   Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  productId   String
  product     DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  code          String @unique // /r/<code>
  commissionPct Float // snapshot no momento da afiliação
  status        String @default("approved") // pending | approved | rejected

  clicks Int @default(0)
  sales  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([affiliateId, productId])
  @@index([productId])
  @@index([code])
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  productId   String
  linkCode    String

  visitorToken String // cookie de atribuição
  ip           String?
  userAgent    String? @db.Text

  createdAt DateTime @default(now())

  @@index([affiliateId])
  @@index([visitorToken])
  @@index([linkCode])
}

model Coproducer {
  id        String         @id @default(cuid())
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId        String?
  name          String
  pixKey        String?
  asaasWalletId String?
  sharePct      Float // % do líquido do produtor

  createdAt DateTime @default(now())

  @@index([productId])
}

model DigitalSale {
  id        String         @id @default(cuid())
  productId String
  product   DigitalProduct @relation(fields: [productId], references: [id])

  // Comprador
  userId     String?
  buyerName  String
  buyerEmail String?
  buyerPhone String?

  // Afiliação
  affiliateId   String?
  affiliateCode String?

  // Valores
  amount          Float // valor pago
  producerAmount  Float @default(0) // líquido do produtor
  affiliateAmount Float @default(0)
  platformFee     Float @default(0) // take rate S&T
  cashbackAmount  Float @default(0) // TenisCash pro comprador

  // Pagamento
  settlementMode String  @default("off_platform") // off_platform | on_platform
  method         String? // pix | card | boleto
  installments   Int     @default(1)

  // Máquina de estados
  status String @default("waiting_payment") // waiting_payment | paid | refunded | chargeback | cancelled | overdue

  // Pix off-platform
  pixPayload String? @db.Text
  pixQrUrl   String?

  // PSP (Asaas)
  pspProvider   String? // asaas
  pspChargeId   String? // id da cobrança no PSP
  pspInvoiceUrl String? // link de pagamento hospedado

  // Token público do checkout/recibo
  publicToken String @unique

  paidAt     DateTime?
  refundedAt DateTime?
  dueDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissions AffiliateCommission[]

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([affiliateId])
}

model AffiliateCommission {
  id          String      @id @default(cuid())
  affiliateId String
  affiliate   Affiliate   @relation(fields: [affiliateId], references: [id])
  saleId      String
  sale        DigitalSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  amount   Float
  status   String  @default("pending") // pending | available | paid | reversed
  payoutId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId])
  @@index([status])
}

model Payout {
  id          String     @id @default(cuid())
  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  // produtor (Professional) também pode sacar saldo on-platform
  professionalId String?

  payeeType String // affiliate | producer
  amount    Float
  pixKey    String?
  method    String  @default("pix")

  status        String  @default("requested") // requested | processing | paid | failed
  pspTransferId String?
  note          String? @db.Text

  requestedAt DateTime  @default(now())
  paidAt      DateTime?

  @@index([affiliateId])
  @@index([professionalId])
  @@index([status])
}

model WebhookEvent {
  id         String  @id @default(cuid())
  provider   String // asaas
  eventType  String
  externalId String  @unique // idempotência
  payload    String  @db.Text
  processed  Boolean @default(false)
  error      String? @db.Text

  createdAt DateTime @default(now())

  @@index([provider])
  @@index([processed])
}

// ============================================================
// DESAPEGA — marketplace de produtos USADOS (C2C moderado)
// ============================================================
// Cliente cadastra um item usado por um link público (fotos + descrição).
// A equipe S&T MODERA (aprova/reprova) antes de publicar na vitrine.
// O contato do vendedor NUNCA é exposto publicamente — a negociação/venda
// passa pela S&T. Pagamento (escrow: comprador paga conta S&T → confirma
// recebimento → repasse ao vendedor menos comissão) fica pra FASE 2.
model DesapegaListing {
  id String @id @default(uuid())

  // Vendedor (quem desapega) — PII, nunca exposto na vitrine pública
  sellerName   String
  sellerPhone  String
  sellerEmail  String?
  sellerPixKey String? // chave Pix pro repasse futuro (fase pagamento)
  sellerCity   String?
  sellerState  String?

  // Produto usado
  category      String  @default("tenis") // tenis | roupa | acessorio | outro
  brand         String?
  model         String // nome/modelo do item
  size          String? // numeração/tamanho
  color         String?
  gender        String? // masculino | feminino | unissex | infantil
  condition     String  @default("seminovo") // novo_na_caixa | seminovo | usado | bastante_usado
  description   String  @db.Text
  askingPrice   Float // quanto o vendedor quer receber
  originalPrice Float? // quanto custou novo (referência)

  // Fotos (array de URLs públicas — fal.storage, com fallback data URL)
  photos Json @default("[]")

  // Moderação
  status          String    @default("pending") // pending | approved | rejected | sold | paused
  rejectionReason String?   @db.Text
  reviewedAt      DateTime?
  reviewedById    String?
  publishedAt     DateTime?
  soldAt          DateTime?

  // Token pro vendedor acompanhar o anúncio sem login
  trackToken String @unique @default(cuid())

  views Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([sellerPhone])
  @@index([category, status])
}

// =====================================================================
// AGENTES — Esteira "Classificação de Card" (orquestrador + sub-agentes)
// Painel ao vivo em /classificacao.html
// =====================================================================
model AgentRun {
  id         String    @id @default(cuid())
  brand      String?
  status     String    @default("running") // running | paused | done | error
  total      Int       @default(0)
  done       Int       @default(0)
  classified Int       @default(0)
  photo      Int       @default(0)
  needsArt   Int       @default(0)
  audited    Int       @default(0)
  published  Int       @default(0)
  errors     Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([status])
}

model AgentEvent {
  id          String   @id @default(cuid())
  runId       String?
  agent       String // orquestrador | classificador | fotografo | designer | auditor | publicador
  productId   String?
  productName String?
  status      String // info | trabalhando | ok | erro | skip | arte
  message     String   @db.Text
  createdAt   DateTime @default(now())

  @@index([runId, createdAt])
  @@index([createdAt])
}

// ============================================================
// META FARDAMENTOS — sistema proprio (ERP / CRM / Estoque / Categoria / Ponto)
// EMPRESA SEPARADA da Sports & Tennis. Tabelas ISOLADAS (prefixo Mf), zero
// mistura com o catalogo/User da S&T. CNPJ 18.034.978/0001-30 · IE 162135491
// App em /metafardamentos · API em /api/mf
// ============================================================

model MfCompany {
  id           String   @id @default(uuid())
  name         String   @default("META FARDAMENTOS LTDA")
  tradeName    String   @default("Meta Fardamentos")
  cnpj         String   @default("18034978000130")
  ie           String?  @default("162135491")
  phone        String?
  email        String?
  address      String?
  street       String?  @default("AVENIDA COREMAS")
  number       String?  @default("372")
  neighborhood String?  @default("CENTRO")
  zip          String?  @default("58013430")
  city         String?  @default("Joao Pessoa")
  state        String?  @default("PB")
  cityCode     String?  @default("2507507")
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MfEmployee {
  id         String    @id @default(uuid())
  name       String
  username   String    @unique // login (sem espaco)
  pinHash    String // bcrypt do PIN/senha
  role       String    @default("funcionario") // admin | gerente | funcionario
  cpf        String?
  phone      String?
  email      String?
  baseSalary Float? // salario mensal (quando mensal/misto)
  payType    String    @default("mensal") // mensal | peca | misto
  pieceRate  Float? // R$ por peca que a pessoa RECEBE (quando peca/misto)
  hireDate   DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  timeEntries MfTimeEntry[]
  movements   MfStockMovement[]
  orders      MfOrder[]
}

model MfCategory {
  id        String       @id @default(uuid())
  name      String
  parentId  String?
  parent    MfCategory?  @relation("MfCatTree", fields: [parentId], references: [id])
  children  MfCategory[] @relation("MfCatTree")
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  products MfProduct[]
}

model MfProduct {
  id          String      @id @default(uuid())
  name        String
  ref         String? // referencia interna / codigo
  ncm         String? // NCM fiscal (ex 61091000 camiseta de algodao)
  categoryId  String?
  category    MfCategory? @relation(fields: [categoryId], references: [id])
  unit        String      @default("un") // un, pc, kit
  size        String? // P/M/G/GG ou numerico (uniforme)
  color       String?
  costPrice   Float       @default(0)
  salePrice   Float       @default(0)
  stock       Int         @default(0) // saldo atual (ledger = MfStockMovement)
  minStock    Int         @default(0) // alerta de estoque baixo
  description String?     @db.Text
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  movements  MfStockMovement[]
  orderItems MfOrderItem[]
  variants   MfProductVariant[]

  @@index([categoryId])
}

model MfStockMovement {
  id           String      @id @default(uuid())
  productId    String
  product      MfProduct   @relation(fields: [productId], references: [id])
  variantId    String? // se mexeu numa variante (grade)
  type         String // entrada | saida | ajuste
  qty          Int // sempre positivo; type define o sinal
  balanceAfter Int? // saldo do produto apos o movimento
  reason       String? // compra, venda, perda, inventario...
  employeeId   String?
  employee     MfEmployee? @relation(fields: [employeeId], references: [id])
  orderId      String?
  createdAt    DateTime    @default(now())

  @@index([productId, createdAt])
}

model MfCustomer {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("pj") // pf | pj
  doc       String? // CNPJ ou CPF
  segment   String? // empresa | escola | time | profissional | EPI | outro
  phone     String?
  email     String?
  address   String?
  cep       String?
  city      String?  @default("Joao Pessoa")
  state     String?  @default("PB")
  cityCode  String?  @default("2507507")
  notes     String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads  MfLead[]
  orders MfOrder[]
}

model MfLead {
  id             String      @id @default(uuid())
  name           String?
  phone          String?
  segment        String?
  tipoFardamento String?
  quantidade     String?
  personalizacao String?
  resumo         String?     @db.Text
  source         String      @default("whatsapp") // whatsapp | manual | instagram
  status         String      @default("novo") // novo | contatado | orcamento | fechado | perdido
  customerId     String?
  customer       MfCustomer? @relation(fields: [customerId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt])
}

model MfOrder {
  id         String      @id @default(uuid())
  number     Int         @default(0) // nº amigavel do pedido/orcamento (setado no app)
  customerId String?
  customer   MfCustomer? @relation(fields: [customerId], references: [id])
  status     String      @default("orcamento") // orcamento | confirmado | producao | entregue | cancelado
  total      Float       @default(0)
  notes      String?     @db.Text
  employeeId String?
  employee   MfEmployee? @relation(fields: [employeeId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  nfeStatus    String?
  nfeModelo    Int?
  nfeChave     String?
  nfeNumero    Int?
  nfeProtocolo String?
  nfeMotivo    String?
  nfeXml       String?   @db.Text
  nfeAt        DateTime?
  stockApplied Boolean   @default(false) // baixa de estoque ja aplicada (entregue)

  items    MfOrderItem[]
  payments MfPayment[]

  @@index([status, createdAt])
}

model MfOrderItem {
  id          String     @id @default(uuid())
  orderId     String
  order       MfOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     MfProduct? @relation(fields: [productId], references: [id])
  variantId   String? // variante (grade tam/cor) escolhida
  description String // texto livre (item sob medida) ou nome do produto
  qty         Int        @default(1)
  unitPrice   Float      @default(0)
  total       Float      @default(0)
}

model MfTimeEntry {
  id         String     @id @default(uuid())
  employeeId String
  employee   MfEmployee @relation(fields: [employeeId], references: [id])
  kind       String // in | out | break_in | break_out
  at         DateTime   @default(now())
  day        String // YYYY-MM-DD (America/Fortaleza) p/ agrupar o dia
  lat        Float?
  lng        Float?
  note       String?

  @@index([employeeId, day])
}

model MfFiscalConfig {
  id             String    @id @default(uuid())
  ambiente       String    @default("homologacao")
  crt            Int       @default(1)
  csosn          String    @default("102")
  cfopDentro     String    @default("5102")
  cfopFora       String    @default("6102")
  defaultNcm     String    @default("61091000")
  nfeSerie       Int       @default(1)
  nfeNextNumber  Int       @default(1)
  certB64        String?   @db.Text
  certPassword   String?
  certSubject    String?
  certValidUntil DateTime?
  enabled        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ApsGroupCapture {
  id         String   @id
  instance   String
  groupId    String?
  isGroup    Boolean  @default(false)
  senderHash String?
  senderName String?
  text       String
  createdAt  DateTime @default(now())

  @@index([instance, groupId, createdAt], map: "ApsGroupCapture_inst_grp_idx")
}

// Monitor de WhatsApp: toda mensagem que CHEGA (e nossas respostas via eco fromMe)
// nas instâncias Evolution (teniscash/baratao/metafardamentos/metaaps) é gravada aqui
// pro dono acompanhar tudo num só lugar (admin → aba WhatsApp). Captura daqui pra frente
// (a Evolution não guarda histórico). NÃO bloqueia o atendente: gravação é try/catch.
model WhatsappMessage {
  id          String   @id @default(cuid())
  instance    String // teniscash | baratao | metafardamentos | metaaps
  chatJid     String // remoteJid (contato ou grupo)
  isGroup     Boolean  @default(false)
  contactName String? // pushName
  phone       String? // telefone do remetente (só dígitos)
  fromMe      Boolean  @default(false) // true = enviada por nós/IA; false = recebida
  text        String? // texto/legenda da mensagem
  msgType     String?  @default("text") // text/image/audio/video/document/...
  messageId   String? // id da Evolution (dedup)
  ts          DateTime @default(now()) // horário da mensagem
  createdAt   DateTime @default(now())

  @@unique([instance, messageId], map: "WhatsappMessage_inst_msgid_uq")
  @@index([instance, ts], map: "WhatsappMessage_inst_ts_idx")
  @@index([instance, chatJid, ts], map: "WhatsappMessage_inst_chat_ts_idx")
}

// Financeiro / Raio-X do dia — despesas operacionais RECORRENTES (mensais):
// folha (1 entrada por colaborador) + fixas (aluguel/energia/água/internet/...).
// O Raio-X divide o amount MENSAL pelos dias do mês pra achar o custo do DIA.
// storeId null = empresa toda (entra só no total da empresa). Os valores são
// SEMPRE cadastrados pelo dono — nunca inventados.
model OperatingExpense {
  id           String   @id @default(cuid())
  category     String // folha | aluguel | energia | agua | internet | software | imposto | marketing | manutencao | outros
  description  String // ex: "Salário João Silva" ou "Aluguel loja Bessa"
  amount       Float // valor MENSAL (R$)
  storeId      String? // FK lógica → Store.id; null = empresa toda
  collaborator String? // nome do colaborador (quando category = folha)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active], map: "OperatingExpense_active_idx")
  @@index([storeId], map: "OperatingExpense_store_idx")
}

// ============================================================
// PACOTE MF — grade (variantes), pagamento e financeiro (2026-06-16)
// Aditivo: produto sem variante segue usando MfProduct.stock (compativel).
// ============================================================

model MfProductVariant {
  id        String    @id @default(uuid())
  productId String
  product   MfProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String? // PP P M G GG EXG ... ou numerico
  color     String?
  sku       String? // codigo de barras / SKU da variante
  stock     Int       @default(0)
  minStock  Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([productId])
}

model MfPayment {
  id         String   @id @default(uuid())
  orderId    String
  order      MfOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount     Float
  method     String   @default("dinheiro") // dinheiro|pix|credito|debito|boleto|transferencia|prazo
  paidAt     DateTime @default(now())
  note       String?
  employeeId String?
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([paidAt])
}

model MfFinanceEntry {
  id          String    @id @default(uuid())
  kind        String // receber | pagar
  description String
  category    String? // aluguel|fornecedor|salario|imposto|venda|servico|outro
  amount      Float     @default(0)
  dueDate     DateTime?
  status      String    @default("aberto") // aberto | pago | cancelado
  paidAt      DateTime?
  method      String?
  orderId     String?
  customerId  String?
  employeeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kind, status])
  @@index([status, dueDate])
}

// ============================================================
// PRODUCAO (facao) — OS + etapas + remuneracao/resultado por pessoa (2026-06-16)
// ============================================================

model MfProductionOrder {
  id           String    @id @default(uuid())
  number       Int       @default(0) // nº amigavel da OS
  title        String // o que vai produzir
  productId    String? // produto do catalogo (opcional)
  orderId      String? // pedido vinculado (opcional)
  customerId   String?
  qty          Int       @default(0) // peças totais
  status       String    @default("aberta") // aberta | producao | concluida | cancelada
  dueDate      DateTime?
  materialCost Float     @default(0) // despesa de material/insumo da OS
  notes        String?   @db.Text
  employeeId   String? // quem abriu
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stages MfProductionStage[]

  @@index([status, createdAt])
}

model MfProductionStage {
  id                String            @id @default(uuid())
  productionOrderId String
  productionOrder   MfProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stage             String // modelagem | corte | costura | estamparia | embalagem
  seq               Int               @default(0)
  assigneeId        String? // quem faz (MfEmployee.id)
  status            String            @default("pendente") // pendente | fazendo | feito
  qty               Int               @default(0) // peças desta etapa
  unitValue         Float             @default(0) // R$/peça = valor da mao de obra desta etapa
  startedAt         DateTime? // bateu ponto: comecou
  doneAt            DateTime? // bateu ponto: terminou
  createdAt         DateTime          @default(now())

  @@index([productionOrderId])
  @@index([assigneeId, doneAt])
}

// ============================================================
// AGENDA DA EQUIPE (gerente) — escala recorrente + atividades (2026-06-16)
// Amarrada no cadastro REAL do vendedor (User role=seller) e na Store.
// Interliga com ponto (ClockIn) e vendas (Sale) no endpoint /week.
// ============================================================

// Escala recorrente: "vendedor X trabalha na loja Y, tal dia da semana, das HH às HH".
model SellerSchedule {
  id        String   @id @default(cuid())
  sellerId  String
  seller    User     @relation("sellerSchedules", fields: [sellerId], references: [id])
  storeId   String
  store     Store    @relation("storeSchedules", fields: [storeId], references: [id])
  weekday   Int // 0=domingo, 1=segunda, ... 6=sábado
  startTime String   @default("09:00") // "HH:MM"
  endTime   String   @default("18:00") // "HH:MM"
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([storeId, weekday])
}

// Escala fechada por mês. Enquanto DRAFT, só a gestão enxerga e edita.
// Ao publicar, os vendedores recebem a versão completa no cadastro pessoal.
model SellerMonthlySchedule {
  id            String                         @id @default(cuid())
  month         String                         @unique // YYYY-MM
  status        String                         @default("DRAFT") // DRAFT | PUBLISHED
  version       Int                            @default(1)
  note          String?
  createdById   String
  createdBy     User                           @relation("monthlyScheduleCreator", fields: [createdById], references: [id])
  publishedById String?
  publishedBy   User?                          @relation("monthlySchedulePublisher", fields: [publishedById], references: [id])
  publishedAt   DateTime?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  shifts        SellerMonthlyShift[]
  receipts      SellerMonthlyScheduleReceipt[]

  @@index([status, month])
}

model SellerMonthlyShift {
  id         String                @id @default(cuid())
  scheduleId String
  schedule   SellerMonthlySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sellerId   String
  seller     User                  @relation("monthlyScheduleSeller", fields: [sellerId], references: [id])
  storeId    String
  store      Store                 @relation("monthlyScheduleStore", fields: [storeId], references: [id])
  workDate   DateTime
  startTime  String
  endTime    String
  note       String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  // Um vendedor fica vinculado a uma única loja por dia. Isso também evita conflito.
  @@unique([sellerId, workDate])
  @@index([scheduleId, workDate])
  @@index([storeId, workDate])
}

model SellerMonthlyScheduleReceipt {
  id             String                @id @default(cuid())
  scheduleId     String
  schedule       SellerMonthlySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         User                  @relation("monthlyScheduleReceiptSeller", fields: [sellerId], references: [id])
  version        Int
  notifiedAt     DateTime              @default(now())
  viewedAt       DateTime?
  acknowledgedAt DateTime?

  @@unique([scheduleId, sellerId, version])
  @@index([sellerId, notifiedAt])
}

// Qualquer atividade/marcação na agenda (folga, férias, treinamento, reunião,
// feriado, meta, evento…). Pode ser de um vendedor, de uma loja, ou geral.
model AgendaActivity {
  id        String    @id @default(cuid())
  title     String
  type      String    @default("evento") // folga|ferias|treinamento|reuniao|feriado|meta|evento|outro
  date      DateTime // dia (ou início) da atividade
  endDate   DateTime? // fim, quando é período (ex: férias)
  allDay    Boolean   @default(true)
  startTime String? // "HH:MM" quando não é allDay
  endTime   String?
  sellerId  String?
  seller    User?     @relation("sellerActivities", fields: [sellerId], references: [id])
  storeId   String?
  store     Store?    @relation("storeActivities", fields: [storeId], references: [id])
  note      String?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([date])
  @@index([sellerId])
  @@index([storeId])
}

// ============================================================
// Tabela do app central-contabil (MESMO banco, schema separado).
// Espelhada aqui SÓ para o `prisma db push` do TenisCash NUNCA tentar
// dropá-la (banco compartilhado). O TenisCash não usa esta tabela.
// ============================================================
model CentralContabilJsonStore {
  id        String   @id
  key       String   @unique
  payload   Json
  checksum  String
  updatedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

// ============================================================
// CANAL DE GESTÃO REMOTA das máquinas das lojas (sem AnyDesk).
// O Supervisor de cada máquina faz PULL: bate heartbeat e busca comandos.
// ============================================================
model AgentCommand {
  id        String   @id @default(cuid())
  storeCode String
  type      String // restart-agent | update-agent | update-supervisor | tailscale-up | funnel-up | get-health | get-log | ping
  args      Json?
  status    String   @default("pending") // pending | sent | done | failed
  result    String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeCode, status])
}

model MachineHeartbeat {
  storeCode         String   @id
  hostname          String?
  agentHealthy      Boolean  @default(false)
  agentVersion      String?
  supervisorVersion String?
  lastSeen          DateTime @default(now())
}

// ============================================================
// FIGURINHAS PANINI — Copa do Mundo FIFA 2026
// ============================================================

model Sticker {
  id            String  @id @default(cuid())
  section       String // "BRA", "FWC", "MUS", "INT"
  sectionName   String // "Brasil", "Especiais FIFA WC"
  confederation String  @default("")
  number        Int // 1-20 por seleção; 1-11 museu; etc.
  label         String // "Escudo", "Jogador 5", "Foto do Time"
  displayCode   String // "BRA-01"
  isShield      Boolean @default(false)
  isTeamPhoto   Boolean @default(false)
  isSpecial     Boolean @default(false)

  userStickers UserSticker[]

  @@unique([section, number])
}

model StickerCollection {
  id           String        @id @default(cuid())
  token        String        @unique @default(cuid())
  username     String?       @unique
  passwordHash String?
  name         String
  whatsapp     String        @default("")
  city         String        @default("")
  neighborhood String        @default("")
  stickers     UserSticker[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UserSticker {
  id           String            @id @default(cuid())
  collectionId String
  collection   StickerCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  stickerId    String
  sticker      Sticker           @relation(fields: [stickerId], references: [id])
  quantity     Int               @default(0)
  updatedAt    DateTime          @updatedAt

  @@unique([collectionId, stickerId])
  @@index([collectionId])
  @@index([stickerId])
}

// ============================================================
// SISTEMA PVM — Padrão, Validação e Monitoramento
// Ciclo: definir padrão → testar pequeno → medir → corrigir →
// padronizar → repetir, por área da loja (atendimento, ambiente,
// produto, preço, vitrine, comunicação, pós-venda, experiência).
// storeId/createdBy soltos DE PROPÓSITO (sem FK em Store/User) —
// prisma db push 100% aditivo, zero risco nas tabelas existentes.
// ============================================================

model PvmFicha {
  id            String    @id @default(cuid())
  area          String // atendimento|ambiente|produto|preco|vitrine|comunicacao|posvenda|experiencia|outro
  problema      String
  hipotese      String
  padraoNovo    String
  storeId       String? // FK lógica → Store.id (vazio = empresa toda)
  storeCode     String?
  testeInicio   DateTime?
  testeFim      DateTime?
  indicadores   Json? // [{nome, meta, resultado}]
  metaMinima    String?
  resultado     String?
  decisao       String? // manter|melhorar|cortar
  status        String    @default("planejada") // planejada|testando|concluida
  createdBy     String? // FK lógica → User.id
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([area])
  @@index([status])
  @@index([storeId])
}

model PvmDiario {
  id                   String   @id @default(cuid())
  date                 DateTime
  storeId              String?
  storeCode            String?
  vendas               Float?
  clientesAprox        Int?
  produtoMaisProcurado String?
  principalReclamacao  String?
  motivoNaoCompra      String?
  algoQueFuncionou     String?
  createdBy            String?
  createdByName        String?
  createdAt            DateTime @default(now())

  @@index([date])
  @@index([storeId])
}

model PvmPadrao {
  id        String   @id @default(cuid())
  categoria String // atendimento|visual|exposicao|som_ambiente|whatsapp|posvenda|outro
  titulo    String
  descricao String
  fichaId   String? // FK lógica → PvmFicha.id (a ficha que originou o padrão)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoria])
}
