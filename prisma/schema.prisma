generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUÁRIOS (clientes + vendedores + admins)
// ============================================================

model User {
  id              String    @id @default(uuid())
  name            String
  phone           String    @unique
  email           String?
  cpf             String?   @unique
  pin             String // hashed
  balance         Float     @default(0) // CASHBACK do cliente — pode transferir, usar em compras
  partnerBalance  Float     @default(0) // COMISSÃO do parceiro — APENAS troca por produtos (não transfere)
  role            String    @default("user") // user, seller, admin, superadmin, partner
  active          Boolean   @default(true)
  welcomeBonus    Boolean   @default(false)
  deletedCpf      String?
  profileComplete Boolean   @default(false)
  lgpdAccepted    Boolean   @default(false)
  lgpdDate        DateTime?

  // Dados pessoais
  birthDate    String?
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?

  // Dados físicos
  height    String?
  weight    String?
  shirtSize String?
  shoeSize  String?

  // CRM Esportivo (cliente)
  sportsPractice String?
  sportsWant     String?
  sportsWhere    String?
  favBrands      String?

  // Dados do vendedor (apenas role=seller)
  storeId      String?
  store        Store?    @relation(fields: [storeId], references: [id])
  hireDate     DateTime?
  baseSalary   Float?
  employeeCode String?   @unique // V001, V002, etc

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations existentes
  sentTransfers     Transaction[] @relation("sender")
  receivedTransfers Transaction[] @relation("receiver")
  adminActions      AdminAction[]

  // Relations vendedor
  clockIns         ClockIn[]        @relation("clockIns")
  clockSummaries   ClockSummary[]   @relation("clockSummaries")
  walletEntries    SellerWallet[]   @relation("walletEntries")
  sellerClients    SellerClient[]   @relation("sellerClients")
  sales            Sale[]           @relation("sellerSales")
  commissions      SaleCommission[] @relation("commissions")
  messagesSent     Message[]        @relation("messagesSent")
  messagesReceived Message[]        @relation("messagesReceived")
  tasksCreated     Task[]           @relation("tasksCreated")
  tasksAssigned    Task[]           @relation("tasksAssigned")
  taskExecutions   TaskExecution[]  @relation("taskExecutions")
  trainings        SellerTraining[] @relation("trainings")
  quizAttempts     QuizAttempt[]    @relation("quizAttempts")
  aiConversations  AIConversation[] @relation("aiConversations")
  productsCreated  Product[]        @relation("productsCreated")

  // Programa de Parceiros
  partner              Partner?      @relation("partner")
  partnerSalesAsSeller PartnerSale[] @relation("partnerSaleSeller")

  // ===== APEX SPORT (app esportivo unificado ao TenisCash) =====
  // O cliente da loja Sports & Tennis é o mesmo atleta do app.
  // Ele compra na loja, treina no app, ganha TenisCash, gasta na próxima compra.
  athleteProfile          AthleteProfile?
  deviceConnections       DeviceConnection[]
  activities              Activity[]
  routes                  Route[]
  segmentEfforts          SegmentEffort[]
  clubMemberships         ClubMembership[]
  challengeParticipations ChallengeParticipation[]
  userPlans               UserPlan[]
  safetyContacts          SafetyContact[]
  badges                  BadgeEarned[]
  consents                Consent[]
  liveTrackingSessions    LiveTrackingSession[]    @relation("liveTrackingOwner")
}

// ============================================================
// MODELOS EXISTENTES (sem alteração)
// ============================================================

model Transaction {
  id          String @id @default(uuid())
  type        String
  amount      Float
  description String

  senderId String?
  sender   User?   @relation("sender", fields: [senderId], references: [id])

  receiverId String?
  receiver   User?   @relation("receiver", fields: [receiverId], references: [id])

  balanceAfter Float?
  metadata     String?

  createdAt DateTime @default(now())
}

model Promo {
  id          String    @id @default(uuid())
  title       String
  description String
  percentage  Float
  scope       String
  scopeValue  String?
  active      Boolean   @default(true)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BrandRule {
  id          String   @id @default(uuid())
  brand       String   @unique
  maxDiscount Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Config {
  id    String @id @default("global")
  key   String @unique
  value String
}

model AdminAction {
  id           String   @id @default(uuid())
  adminId      String
  admin        User     @relation(fields: [adminId], references: [id])
  action       String
  targetUserId String?
  amount       Float?
  description  String
  metadata     String?
  createdAt    DateTime @default(now())
}

// ============================================================
// MÓDULO 0 — LOJAS
// ============================================================

model Store {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  dna       String? // Masculino, Feminino, Futebol, Geral
  mall      String? // Parahyba Mall, Pirâmide, Complexo K, Tambiá
  address   String?
  city      String?
  state     String?
  phone     String?
  latitude  Float?
  longitude Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // CNPJ que emite NFCe/NFe pelas vendas dessa loja
  fiscalIssuerId String?
  fiscalIssuer   FiscalIssuer? @relation(fields: [fiscalIssuerId], references: [id])

  sellers  User[]
  clockIns ClockIn[]
  messages Message[]    @relation("storeMessages")
  stocks   StoreStock[]
}

// ============================================================
// MÓDULO 1 — PONTO DIGITAL
// ============================================================

model ClockIn {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("clockIns", fields: [userId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  type      String // entry, break_start, break_end, exit
  timestamp DateTime @default(now())
  latitude  Float?
  longitude Float?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, timestamp])
}

model ClockSummary {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("clockSummaries", fields: [userId], references: [id])
  date            DateTime
  totalMinutes    Int
  breakMinutes    Int      @default(0)
  overtimeMinutes Int      @default(0)
  status          String   @default("normal")
  createdAt       DateTime @default(now())

  @@unique([userId, date])
}

// ============================================================
// MÓDULO 2 — CARTEIRA DO VENDEDOR
// ============================================================

model SellerWallet {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("walletEntries", fields: [userId], references: [id])
  type        String // salary, commission, vt, vr, bonus, overtime, deduction, advance
  amount      Float
  description String
  reference   String? // "2026-04"
  metadata    String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, reference])
}

// ============================================================
// MÓDULO 3 — CATÁLOGO
// ============================================================

model Product {
  id          String  @id @default(uuid())
  sku         String  @unique
  name        String
  brand       String
  category    String // tenis, roupa, acessorio
  subcategory String?

  shortDescription  String?
  longDescription   String?
  features          Json?
  aiContext         Json?
  recommendedFor    Json?
  notRecommendedFor Json?

  imageUrl  String?
  imageUrls Json?

  price         Float
  promoPrice    Float?
  costPrice     Float? // custo unitário (média ponderada das NF-es). Usado pra calcular preço via markup.
  markupPercent Float? // override por produto. null = herda markup do Supplier (averageMarkup).

  // Fiscal — usado na emissão de NFe/NFCe (campos obrigatórios pela SEFAZ)
  ncm           String? // NCM (Nomenclatura Comum do Mercosul) — 8 dígitos
  cest          String? // CEST (substituição tributária) — opcional
  origem        Int     @default(0) // 0=Nacional, 1=Importação direta, 2=Importação adq merc nac, ...
  cfop          String? // CFOP padrão — sobrescreve o do issuer se preenchido (formato 4 dígitos)
  unidade       String  @default("UN") // unidade de medida fiscal

  active   Boolean @default(true)
  featured Boolean @default(false)
  source   String  @default("manual") // manual, csv, ai

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("productsCreated", fields: [createdById], references: [id])

  sizes     ProductSize[]
  saleItems SaleItem[]
  trainings SellerTraining[]
  quizzes   Quiz[]

  @@index([brand, category])
  @@index([active, featured])
}

model AIConversation {
  id         String  @id @default(uuid())
  userId     String?
  user       User?   @relation("aiConversations", fields: [userId], references: [id])
  userType   String // seller, client, guest
  sessionKey String? // identifica convidado (UUID do cliente) p/ limite diário

  title    String?
  messages Json    @default("[]")

  totalTokensIn  Int   @default(0)
  totalTokensOut Int   @default(0)
  totalCostBRL   Float @default(0)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
  @@index([sessionKey])
}

model ProductSize {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  size      String
  stock     Int     @default(0) // estoque AGREGADO (legado) — fonte da verdade vira StoreStock
  barcode   String?

  storeStocks StoreStock[]

  @@unique([productId, size])
}

// Estoque por loja — fonte da verdade. Cada (loja, tamanho) tem uma linha.
model StoreStock {
  id            String      @id @default(uuid())
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id])
  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  stock         Int         @default(0)
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())

  @@unique([storeId, productSizeId])
  @@index([storeId])
  @@index([productSizeId])
}

// ============================================================
// MÓDULO 4 — CRM DO VENDEDOR
// ============================================================

model SellerClient {
  id            String    @id @default(uuid())
  sellerId      String
  seller        User      @relation("sellerClients", fields: [sellerId], references: [id])
  tcUserId      String?
  name          String
  phone         String?
  email         String?
  cpf           String?
  birthDate     String?
  address       String?
  city          String?
  state         String?
  height        String?
  weight        String?
  shirtSize     String?
  shoeSize      String?
  notes         String?
  tags          String?
  lastPurchase  DateTime?
  totalSpent    Float     @default(0)
  purchaseCount Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sales Sale[]

  @@index([sellerId])
  @@index([birthDate])
}

// ============================================================
// MÓDULO 5 — VENDAS
// ============================================================

model Sale {
  id            String        @id @default(uuid())
  sellerId      String
  seller        User          @relation("sellerSales", fields: [sellerId], references: [id])
  clientId      String?
  client        SellerClient? @relation(fields: [clientId], references: [id])
  storeId       String?
  totalAmount   Float
  tcUsed        Float         @default(0)
  tcEarned      Float         @default(0)
  paymentMethod String?
  status        String        @default("completed")
  erpReference  String?
  note          String?
  createdAt     DateTime      @default(now())

  items       SaleItem[]
  commissions SaleCommission[]

  @@index([sellerId, createdAt])
  @@index([clientId])
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String
  brand       String
  category    String?
  size        String?
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
}

// ============================================================
// MÓDULO 6 — COMISSÕES
// ============================================================

model BrandCommission {
  id            String   @id @default(uuid())
  brand         String   @unique
  commissionPct Float
  bonusPct      Float?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SaleCommission {
  id         String    @id @default(uuid())
  saleId     String
  sale       Sale      @relation(fields: [saleId], references: [id])
  sellerId   String
  seller     User      @relation("commissions", fields: [sellerId], references: [id])
  brand      String
  saleAmount Float
  pct        Float
  amount     Float
  status     String    @default("pending")
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([sellerId, status])
}

// ============================================================
// MÓDULO 7 — COMUNICAÇÃO INTERNA
// ============================================================

model Message {
  id     String @id @default(uuid())
  fromId String
  from   User   @relation("messagesSent", fields: [fromId], references: [id])

  // Destinatário (pelo menos um deve estar preenchido)
  toId      String? // mensagem direta a um usuário (fan-out também usa isso)
  to        User?   @relation("messagesReceived", fields: [toId], references: [id])
  toStoreId String? // broadcast pra loja (apenas rastreio)
  toStore   Store?  @relation("storeMessages", fields: [toStoreId], references: [id])
  toAll     Boolean @default(false) // broadcast pra todas as lojas (apenas rastreio)

  // Tipo
  type String // 'message', 'demand', 'announcement', 'request'

  // Conteúdo
  title   String? // obrigatório pra demand/announcement/request
  content String

  // Demand fields
  priority String? // 'low', 'normal', 'high', 'urgent' (só pra demand)
  dueDate  DateTime? // só pra demand

  // Status
  status   String    @default("sent") // sent, read, doing, done, confirmed, replied, approved, rejected
  readAt   DateTime?
  doneAt   DateTime?
  doneById String?

  // Resposta (pra request)
  parentId     String?
  replyContent String?
  repliedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([toId, status])
  @@index([toStoreId, status])
  @@index([type, status])
}

model Channel {
  id          String   @id @default(uuid())
  name        String
  type        String
  storeId     String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================================
// MÓDULO 8 — TAREFAS
// ============================================================

model Task {
  id           String    @id @default(uuid())
  title        String
  description  String?
  createdById  String
  createdBy    User      @relation("tasksCreated", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("tasksAssigned", fields: [assignedToId], references: [id])
  storeId      String?
  type         String    @default("once")
  priority     String    @default("normal")
  dueDate      DateTime?
  recurrence   String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  executions TaskExecution[]
}

model TaskExecution {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id])
  userId      String
  user        User     @relation("taskExecutions", fields: [userId], references: [id])
  date        DateTime
  status      String   @default("done")
  note        String?
  photoUrl    String?
  completedAt DateTime @default(now())

  @@index([taskId, date])
  @@index([userId, date])
}

// ============================================================
// MÓDULO 9 — TREINAMENTO + QUIZ
// ============================================================

model SellerTraining {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("trainings", fields: [userId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  topic       String
  type        String   @default("product")
  source      String?
  completedAt DateTime @default(now())
  score       Float?
  certified   Boolean  @default(false)
  metadata    String?

  @@index([userId])
}

model Quiz {
  id        String   @id @default(uuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  topic     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  questions QuizQuestion[]
}

model QuizQuestion {
  id           String  @id @default(uuid())
  quizId       String
  quiz         Quiz    @relation(fields: [quizId], references: [id])
  question     String
  options      String // JSON array
  correctIndex Int
  explanation  String?
  order        Int     @default(0)
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("quizAttempts", fields: [userId], references: [id])
  quizId      String
  answers     String // JSON
  score       Float
  passed      Boolean
  completedAt DateTime @default(now())

  @@index([userId, quizId])
}

// ============================================================
// MÓDULO 10 — PROGRAMA DE PARCEIROS (afiliados)
// ============================================================

model Partner {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("partner", fields: [userId], references: [id])

  type   String // 'atleta', 'influencer', 'saude', 'personal', 'outro'
  status String @default("active") // active, paused, banned

  couponCode    String @unique // ex: PEDRO, CARLA-RUN
  discountPct   Float  @default(5) // % desconto pro cliente
  commissionPct Float  @default(3) // % comissão pro parceiro

  // Estatísticas (denormalizadas pra dashboard rápido)
  totalSales      Int    @default(0)
  totalRevenue    Float  @default(0)
  totalCommission Float  @default(0)
  tier            String @default("bronze") // bronze, prata, ouro, platina

  // Info do parceiro
  bio         String?
  socialMedia String? // JSON
  followers   Int?
  niche       String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales PartnerSale[]

  @@index([status])
  @@index([tier])
}

model PartnerSale {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  customerName  String?
  customerCpf   String? // mascarado (apenas dígitos limpos)
  customerPhone String?

  saleAmount     Float // valor TOTAL da venda (após desconto)
  saleAmountFull Float // valor SEM desconto
  discountValue  Float // valor do desconto aplicado
  commissionT    Float // T$ que o parceiro ganhou

  products String? // JSON com produtos vendidos

  status   String  @default("approved") // approved, pending, refunded
  storeId  String?
  sellerId String? // vendedor que registrou a venda
  seller   User?   @relation("partnerSaleSeller", fields: [sellerId], references: [id])

  createdAt DateTime @default(now())

  @@index([partnerId, createdAt])
  @@index([customerCpf, createdAt])
}

// ============================================================
// CAMADA DE AGENTES IA — Central IA Sports & Tennis
// ============================================================
// Modelos para o Orquestrador Central, agentes especialistas,
// aprovações humanas, logs de IA e Life Assessor.
// Nomenclatura técnica genérica para permitir evolução futura
// para ST Core / ST OS sem refactor estrutural.

model AIAgent {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  category    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIOrchestration {
  id          String   @id @default(cuid())
  objective   String
  company     String?  @default("Sports & Tennis")
  status      String   @default("pending") // pending, running, completed, failed
  input       Json?
  context     Json?
  result      Json?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks     AIOrchestrationTask[]
  approvals AIApproval[]

  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

model AIOrchestrationTask {
  id              String   @id @default(cuid())
  orchestrationId String
  agentCode       String
  task            String
  status          String   @default("pending") // pending, running, completed, failed
  input           Json?
  output          Json?
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orchestration AIOrchestration @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  @@index([orchestrationId])
  @@index([agentCode, status])
}

model AIApproval {
  id              String    @id @default(cuid())
  orchestrationId String?
  type            String // discount, whatsapp_bulk, paid_campaign, stock_purchase, balance_change, etc.
  title           String
  description     String?
  riskLevel       String    @default("medium") // low, medium, high
  status          String    @default("pending") // pending, approved, rejected, correction_requested, executed, cancelled
  payload         Json?
  approvedById    String?
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orchestration AIOrchestration? @relation(fields: [orchestrationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, status])
}

model AILog {
  id          String   @id @default(cuid())
  agentCode   String
  action      String
  input       Json?
  output      Json?
  error       String?
  cost        Float?
  tokens      Int?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([agentCode, createdAt])
  @@index([createdAt])
}

// ============================================================
// LIFE AGENT — perfil de vida ativa do assinante
// ============================================================

model UserLifeProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  sportsPracticed   Json?
  sportsWanted      Json?
  goals             Json?
  routine           Json?
  preferences       Json?
  culturalInterests Json?
  budgetProfile     String?
  availability      Json?
  energyPattern     Json?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserMoodCheckin {
  id        String   @id @default(cuid())
  userId    String
  mood      String?
  energy    String?
  context   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model UserTrainingLog {
  id          String   @id @default(cuid())
  userId      String
  sport       String?
  title       String?
  durationMin Int?
  intensity   String?
  location    String?
  teacherName String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model UserRecommendation {
  id            String   @id @default(cuid())
  userId        String
  source        String   @default("life-assessor-agent")
  input         Json?
  possibilities Json?
  selected      Json?
  status        String   @default("generated") // generated, viewed, acted, dismissed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
}

model UserAction {
  id               String    @id @default(cuid())
  userId           String
  recommendationId String?
  type             String // schedule, invite, buy, rest, train, attend_event, message, learn, other
  title            String
  status           String    @default("pending") // pending, approved, rejected, executed, cancelled
  payload          Json?
  requiresApproval Boolean   @default(true)
  approvedAt       DateTime?
  executedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
}

// ============================================================
// TENISCASH OS — ERP/CRM/Operacional integrado
// ============================================================
// Conjunto de módulos:
//   - Etiquetas (PDF)
//   - Curadoria Exposta
//   - Carteira do Vendedor + Entrevista Semanal
//   - XML NF-e (entrada fiscal)
//   - Recomendações por regra
//   - Nuvemshop (canal)
//   - Ciclo de vida de produto / Inventário avançado

// ============================================================
// ETIQUETAS
// ============================================================

model LabelTemplate {
  id                   String   @id @default(cuid())
  name                 String
  type                 String // PRODUCT | PRICE | PROMOTIONAL | SHELF | ORDER_PICKING | SHIPPING | INVENTORY
  widthMm              Float
  heightMm             Float
  columns              Int      @default(1)
  rows                 Int      @default(1)
  paperSize            String   @default("A4") // A4 | THERMAL
  marginTopMm          Float    @default(0)
  marginLeftMm         Float    @default(0)
  gapHorizontalMm      Float    @default(0)
  gapVerticalMm        Float    @default(0)
  showLogo             Boolean  @default(true)
  showPrice            Boolean  @default(true)
  showPromotionalPrice Boolean  @default(false)
  showBarcode          Boolean  @default(true)
  showQRCode           Boolean  @default(false)
  showSku              Boolean  @default(true)
  showProductName      Boolean  @default(true)
  showBrand            Boolean  @default(true)
  showModel            Boolean  @default(false)
  showSize             Boolean  @default(false)
  showColor            Boolean  @default(false)
  showStore            Boolean  @default(false)
  layoutConfig         Json?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  batches LabelBatch[]
}

model LabelBatch {
  id          String   @id @default(cuid())
  name        String
  templateId  String
  createdById String?
  storeId     String?
  status      String   @default("DRAFT") // DRAFT | GENERATED | PRINTED | CANCELLED
  totalLabels Int      @default(0)
  pdfUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template LabelTemplate   @relation(fields: [templateId], references: [id])
  items    LabelItem[]
  prints   LabelPrintLog[]

  @@index([status, createdAt])
  @@index([storeId])
}

model LabelItem {
  id               String   @id @default(cuid())
  labelBatchId     String
  productId        String?
  inventoryId      String?
  quantity         Int      @default(1)
  price            Float?
  promotionalPrice Float?
  barcode          String?
  qrCodeValue      String?
  customText       String?
  createdAt        DateTime @default(now())

  batch LabelBatch @relation(fields: [labelBatchId], references: [id], onDelete: Cascade)

  @@index([labelBatchId])
}

model LabelPrintLog {
  id           String   @id @default(cuid())
  labelBatchId String
  printedById  String?
  printedAt    DateTime @default(now())
  printerName  String?
  copies       Int      @default(1)
  notes        String?

  batch LabelBatch @relation(fields: [labelBatchId], references: [id], onDelete: Cascade)

  @@index([labelBatchId])
}

// ============================================================
// CURADORIA EXPOSTA
// ============================================================

model StoreCuration {
  id                  String    @id @default(cuid())
  name                String
  storeId             String
  storeDNA            String?
  theme               String?
  commercialObjective String?
  startDate           DateTime?
  endDate             DateTime?
  status              String    @default("DRAFT") // DRAFT | SETUP | ACTIVE | FINISHED | CANCELLED
  responsibleUserId   String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items     StoreCurationItem[]
  checklist StoreCurationChecklist[]
  photos    StoreCurationPhoto[]
  result    StoreCurationResult?

  @@index([storeId, status])
  @@index([status, startDate])
}

model StoreCurationZone {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  type        String // WINDOW | ENTRANCE | CENTRAL_TABLE | LEFT_WALL | RIGHT_WALL | RACK | CHECKOUT | PROMOTIONAL_AREA | FOOTBALL_AREA | RUNNING_AREA | WOMEN_AREA | MEN_AREA | OTHER
  description String?
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items  StoreCurationItem[]
  photos StoreCurationPhoto[]

  @@index([storeId, type])
}

model StoreCurationItem {
  id               String   @id @default(cuid())
  curationId       String
  productId        String?
  inventoryId      String?
  zoneId           String?
  commercialRole   String? // HERO_PRODUCT | ENTRY_PRODUCT | MARGIN_PRODUCT | FAST_TURNOVER | SLOW_MOVING | DESIRE_PRODUCT | CAMPAIGN_PRODUCT | COMPLEMENTARY_PRODUCT | REBUY_PRODUCT | CONTENT_PRODUCT
  displayPriority  Int      @default(0)
  storytellingText String?
  priceStrategy    String?
  expectedGoal     String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  curation StoreCuration      @relation(fields: [curationId], references: [id], onDelete: Cascade)
  zone     StoreCurationZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([curationId])
  @@index([productId])
  @@index([zoneId])
}

model StoreCurationChecklist {
  id                String    @id @default(cuid())
  curationId        String
  task              String
  responsibleUserId String?
  dueDate           DateTime?
  status            String    @default("PENDING") // PENDING | IN_PROGRESS | DONE | CANCELLED
  completedAt       DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  curation StoreCuration @relation(fields: [curationId], references: [id], onDelete: Cascade)

  @@index([curationId, status])
}

model StoreCurationPhoto {
  id           String   @id @default(cuid())
  curationId   String
  zoneId       String?
  uploadedById String?
  imageUrl     String
  caption      String?
  createdAt    DateTime @default(now())

  curation StoreCuration      @relation(fields: [curationId], references: [id], onDelete: Cascade)
  zone     StoreCurationZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([curationId])
}

model StoreCurationResult {
  id                 String   @id @default(cuid())
  curationId         String   @unique
  revenueGenerated   Float    @default(0)
  itemsSold          Int      @default(0)
  conversionRate     Float?
  topSellingProducts Json?
  slowProducts       Json?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  curation StoreCuration @relation(fields: [curationId], references: [id], onDelete: Cascade)
}

// ============================================================
// CARTEIRA DO VENDEDOR
// ============================================================

model SellerPortfolio {
  id          String   @id @default(cuid())
  sellerId    String
  storeId     String?
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId])
}

model SellerCustomerAssignment {
  id                 String    @id @default(cuid())
  sellerId           String
  customerId         String // pode ser User.id OU SellerClient.id (versão atual usa SellerClient)
  storeId            String?
  relationshipStatus String    @default("NEW_LEAD") // NEW_LEAD | ATTENDED | BUYER | ALMOST_BOUGHT | RECURRING | INACTIVE | VIP | PRICE_SENSITIVE | HIGH_INTENT | REBUY_OPPORTUNITY | LOST
  priority           String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  nextAction         String?
  nextActionDate     DateTime?
  potentialValue     Float?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([sellerId, relationshipStatus])
  @@index([sellerId, priority])
  @@index([customerId])
}

model CustomerInteraction {
  id              String    @id @default(cuid())
  customerId      String
  sellerId        String
  storeId         String?
  channel         String // WHATSAPP | PHONE | INSTAGRAM | IN_STORE | NUVEMSHOP | APP | OTHER
  interactionType String // FIRST_CONTACT | FOLLOW_UP | POST_SALE | REBUY | COMPLAINT | PRODUCT_INTEREST | PRICE_NEGOTIATION | VISIT_INVITATION
  productId       String?
  summary         String?
  result          String?
  nextAction      String?
  nextActionDate  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([sellerId, createdAt])
  @@index([customerId, createdAt])
}

model SellerTask {
  id          String    @id @default(cuid())
  sellerId    String
  customerId  String?
  storeId     String?
  title       String
  description String?
  type        String // CALL_CUSTOMER | SEND_WHATSAPP | INVITE_TO_STORE | SEND_PROMOTION | FOLLOW_UP | POST_SALE | REACTIVATE_CUSTOMER | SEND_PRODUCT
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  dueDate     DateTime?
  status      String    @default("TODO") // TODO | IN_PROGRESS | DONE | CANCELLED
  result      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sellerId, status])
  @@index([dueDate, status])
}

// ============================================================
// ENTREVISTA SEMANAL
// ============================================================

model SellerWeeklyInterview {
  id               String    @id @default(cuid())
  sellerId         String
  storeId          String?
  weekStartDate    DateTime
  weekEndDate      DateTime
  status           String    @default("DRAFT") // DRAFT | SUBMITTED | REVIEWED | ARCHIVED
  moodScore        Int?
  confidenceScore  Int?
  salesEnergyScore Int?
  mainObjective    String?
  summary          String?
  aiAnalysis       String?
  managerNotes     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  submittedAt      DateTime?

  answers  SellerInterviewAnswer[]
  insights SellerInsight[]

  @@unique([sellerId, weekStartDate])
  @@index([sellerId, weekStartDate])
  @@index([status, weekStartDate])
}

model SellerInterviewAnswer {
  id           String   @id @default(cuid())
  interviewId  String
  questionKey  String
  questionText String
  answerText   String?
  category     String // PERSONAL_STATE | SELLER_PROFILE | CUSTOMER_INSIGHT | PRODUCT_DEMAND | SOCIAL_TRENDS | STORE_EXPOSURE | COMPETITION | IDEAS
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interview SellerWeeklyInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([category])
}

model SellerInsight {
  id                String   @id @default(cuid())
  sellerId          String
  storeId           String?
  interviewId       String?
  type              String // CUSTOMER_OPPORTUNITY | PRODUCT_DEMAND | MISSING_PRODUCT | PRICE_OBJECTION | SOCIAL_TREND | STORE_DISPLAY | CAMPAIGN_IDEA | TRAINING_NEED | TEAM_ALERT
  title             String
  description       String?
  priority          String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  relatedProductId  String?
  relatedCustomerId String?
  relatedCampaignId String?
  status            String   @default("OPEN") // OPEN | IN_REVIEW | ACTION_CREATED | RESOLVED | ARCHIVED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  interview SellerWeeklyInterview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([status, priority])
  @@index([type, status])
  @@index([sellerId, createdAt])
}

model SellerMoodLog {
  id              String   @id @default(cuid())
  sellerId        String
  storeId         String?
  date            DateTime @default(now())
  moodScore       Int?
  confidenceScore Int?
  energyScore     Int?
  stressLevel     Int?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([sellerId, date])
}

model SellerProductFeedback {
  id               String   @id @default(cuid())
  sellerId         String
  storeId          String?
  productId        String
  weekStartDate    DateTime
  impactScore      Int?
  demandScore      Int?
  objectionScore   Int?
  customerReaction String?
  feedback         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productId, weekStartDate])
  @@index([sellerId, weekStartDate])
}

model SellerTrendReport {
  id              String   @id @default(cuid())
  sellerId        String
  storeId         String?
  weekStartDate   DateTime
  source          String? // INSTAGRAM | TIKTOK | YOUTUBE | LOJA_CONCORRENTE | CLIENTE | OUTRO
  trendName       String
  description     String?
  relatedBrand    String?
  relatedProduct  String?
  socialNetwork   String?
  potentialImpact String?
  createdAt       DateTime @default(now())

  @@index([weekStartDate])
  @@index([sellerId])
}

// ============================================================
// XML NF-e (importação fiscal)
// ============================================================

model XmlExportJob {
  id            String    @id @default(cuid())
  name          String
  type          String // FULL_BACKUP | PRODUCTS | INVENTORY | CUSTOMERS | SALES | FINANCE | SUPPLIERS | CAMPAIGNS | CURATION | SELLER_PORTFOLIO | SELLER_INTERVIEWS | NUVEMSHOP | LABELS | TENISCASH
  module        String?
  status        String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  requestedById String?
  storeId       String?
  dateFrom      DateTime?
  dateTo        DateTime?
  filters       Json?
  totalRecords  Int       @default(0)
  fileUrl       String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  errorMessage  String?

  @@index([status, createdAt])
}

model XmlImportJob {
  id                      String    @id @default(cuid())
  name                    String
  type                    String // NFE_ENTRY | PRODUCTS | INVENTORY | CUSTOMERS | SALES | SUPPLIERS
  status                  String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  uploadedById            String?
  fileUrl                 String?
  originalFileName        String?
  totalItems              Int       @default(0)
  processedItems          Int       @default(0)
  createdProducts         Int       @default(0)
  updatedProducts         Int       @default(0)
  createdInventoryEntries Int       @default(0)
  errorMessage            String?
  createdAt               DateTime  @default(now())
  completedAt             DateTime?

  fiscalDocuments XmlFiscalDocument[]

  @@index([status, createdAt])
  @@index([type])
}

model XmlFiscalDocument {
  id            String    @id @default(cuid())
  importJobId   String?
  accessKey     String?   @unique
  number        String?
  series        String?
  issuerCnpj    String?
  issuerName    String?
  recipientCnpj String?
  issueDate     DateTime?
  totalValue    Float?
  icmsValue     Float?
  ipiValue      Float?
  pisValue      Float?
  cofinsValue   Float?
  rawXmlUrl     String?
  supplierId    String?
  status        String    @default("imported") // imported | matched | partial | rejected
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  importJob XmlImportJob?   @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  items     XmlFiscalItem[]

  @@index([supplierId])
  @@index([status, issueDate])
}

model XmlFiscalItem {
  id               String   @id @default(cuid())
  fiscalDocumentId String
  productId        String?
  supplierCode     String?
  description      String
  ean              String?
  ncm              String?
  cfop             String?
  cst              String?
  unit             String?
  quantity         Float    @default(0)
  unitValue        Float    @default(0)
  totalValue       Float    @default(0)
  icmsValue        Float?
  ipiValue         Float?
  pisValue         Float?
  cofinsValue      Float?
  matchStatus      String   @default("pending") // pending | matched | new_product | ignored
  createdAt        DateTime @default(now())

  fiscalDocument XmlFiscalDocument @relation(fields: [fiscalDocumentId], references: [id], onDelete: Cascade)

  @@index([fiscalDocumentId])
  @@index([productId])
}

// ============================================================
// NUVEMSHOP
// ============================================================

model NuvemshopConnection {
  id              String   @id @default(cuid())
  storeId         String?  @unique
  nuvemshopUserId String   @unique
  accessToken     String
  scope           String?
  status          String   @default("active") // active | revoked | error
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NuvemshopWebhookEvent {
  id                  String    @id @default(cuid())
  event               String
  nuvemshopResourceId String?
  payload             Json?
  processed           Boolean   @default(false)
  processedAt         DateTime?
  error               String?
  createdAt           DateTime  @default(now())

  @@index([event, processed])
  @@index([processed, createdAt])
}

model NuvemshopSyncLog {
  id        String   @id @default(cuid())
  type      String // import | export | webhook
  entity    String // product | order | customer | inventory
  status    String // ok | error
  message   String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}

model NuvemshopProductMapping {
  id                 String   @id @default(cuid())
  localProductId     String   @unique
  nuvemshopProductId String
  syncStatus         String   @default("synced")
  lastSyncedAt       DateTime @default(now())

  @@index([nuvemshopProductId])
}

model NuvemshopVariantMapping {
  id                 String   @id @default(cuid())
  localInventoryId   String   @unique
  localProductId     String
  nuvemshopProductId String
  nuvemshopVariantId String
  sku                String?
  barcode            String?
  lastSyncedAt       DateTime @default(now())

  @@index([nuvemshopVariantId])
}

model NuvemshopOrderMapping {
  id               String   @id @default(cuid())
  saleId           String?  @unique
  nuvemshopOrderId String   @unique
  payload          Json?
  createdAt        DateTime @default(now())
}

model NuvemshopCustomerMapping {
  id                  String   @id @default(cuid())
  customerId          String?  @unique
  nuvemshopCustomerId String   @unique
  createdAt           DateTime @default(now())
}

// ============================================================
// AI / Regras de Recomendação operacional
// ============================================================

model AiRecommendation {
  id                String    @id @default(cuid())
  type              String // SALES_ACTION | INVENTORY_RISK | REBUY | CLEARANCE | CUSTOMER_REACTIVATION | SELLER_TASK | CURATION_SUGGESTION | FINANCE_ALERT | CAMPAIGN_IDEA | NUVEMSHOP_ALERT | XML_IMPORT_ALERT
  title             String
  description       String?
  priority          String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  relatedStoreId    String?
  relatedProductId  String?
  relatedCustomerId String?
  relatedSellerId   String?
  relatedCampaignId String?
  status            String    @default("OPEN") // OPEN | IN_REVIEW | ACTION_CREATED | RESOLVED | ARCHIVED
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  @@index([status, priority])
  @@index([type, status])
  @@index([createdAt])
}

// ============================================================
// CICLO DE VIDA DE PRODUTO (extensão do Product atual)
// ============================================================

model ProductLifecycle {
  id                 String    @id @default(cuid())
  productId          String    @unique
  storeId            String?
  launchDate         DateTime?
  purchaseDate       DateTime?
  stockEntryDate     DateTime?
  storeEntryDate     DateTime?
  firstSaleDate      DateTime?
  lastSaleDate       DateTime?
  soldOutDate        DateTime?
  lifecycleStatus    String    @default("NEW") // NEW | TESTING | FAST_TURNOVER | NORMAL_TURNOVER | SLOW_TURNOVER | STUCK | CLEARANCE | SOLD_OUT | REBUY | DO_NOT_REBUY
  daysUntilFirstSale Int?
  daysToSellOut      Int?
  daysInStock        Int?
  lastEvaluatedAt    DateTime  @default(now())
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([lifecycleStatus])
  @@index([storeId, lifecycleStatus])
}

// ============================================================
// FORNECEDORES (TenisCash OS — separado do Partner do programa)
// ============================================================

model Supplier {
  id                  String   @id @default(cuid())
  companyName         String
  cnpj                String?  @unique
  representativeName  String?
  phone               String?
  email               String?
  suppliedBrands      Json?
  commercialTerms     String?
  averageMarkup       Float?
  paymentDeadline     Int?
  notes               String?
  profitabilityRating Int? // 1..5
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([active])
}

// ============================================================
// FINANCEIRO (contas a pagar / receber)
// ============================================================

model AccountPayable {
  id          String    @id @default(cuid())
  supplierId  String?
  description String
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  status      String    @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  category    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, dueDate])
  @@index([supplierId])
}

model AccountReceivable {
  id           String    @id @default(cuid())
  customerId   String?
  saleId       String?
  description  String
  amount       Float
  dueDate      DateTime
  receivedDate DateTime?
  status       String    @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  category     String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, dueDate])
  @@index([customerId])
}

// ============================================================
// CAMPANHAS (marketing/ativação)
// ============================================================

model Campaign {
  id               String    @id @default(cuid())
  name             String
  channel          String? // INSTAGRAM | WHATSAPP | LOJA_FISICA | NUVEMSHOP | MIX
  storeId          String?
  budget           Float?
  startDate        DateTime?
  endDate          DateTime?
  generatedRevenue Float     @default(0)
  roi              Float?
  status           String    @default("DRAFT") // DRAFT | ACTIVE | FINISHED | CANCELLED
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customers CampaignCustomer[]
  products  CampaignProduct[]

  @@index([status, startDate])
  @@index([storeId])
}

model CampaignCustomer {
  id         String   @id @default(cuid())
  campaignId String
  customerId String
  status     String   @default("targeted") // targeted | contacted | converted | lost
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerId])
  @@index([campaignId])
}

model CampaignProduct {
  id         String   @id @default(cuid())
  campaignId String
  productId  String
  role       String? // hero | complement | clearance
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([campaignId])
}

// ============================================================
// APEX SPORT — APP ESPORTIVO (unificado ao TenisCash)
// ============================================================
// O atleta é o mesmo User da loja Sports & Tennis. Não duplicamos identidade.
// Aqui fica o domínio de atividade física, treino, social, gamificação.
// PostGIS / ClickHouse / Kafka não estão configurados ainda — modelos prontos
// pra quando o cluster vier no ar. Streams de GPS/HR ficam fora deste schema
// (ClickHouse), só sumários ficam aqui.
// ============================================================

model AthleteProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username        String?  @unique // handle do atleta no app
  goals           Json? // {target_distance, target_race, ...}
  experienceLevel String? // beginner | intermediate | advanced
  zones           Json? // HR zones, pace zones, power zones
  privacyDefaults Json? // visibility default por tipo de atividade
  birthYear       Int?
  sex             String? // M | F | NB | UNSPECIFIED
  // weight/height já existem em User (weight, height) — reusamos
  bio             String?
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Consent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     String // health_data, location_history, heatmap_optin, marketing, ...
  granted   Boolean
  version   String
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId, scope])
}

model DeviceConnection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String // apple_health, health_connect, garmin, polar, oura, whoop
  externalUserId  String
  accessTokenRef  String? // referencia pro vault, NÃO o token em si
  refreshTokenRef String?
  scopes          String[]
  status          String    @default("active")
  connectedAt     DateTime  @default(now())
  lastSyncAt      DateTime?

  @@unique([provider, externalUserId])
  @@index([userId])
}

model Activity {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  sportType      String // RUN, RIDE, SWIM, WALK, HIKE, TRAIL, STRENGTH, YOGA, TENNIS, PADEL ...
  startedAt      DateTime
  endedAt        DateTime?
  elapsedTimeS   Int
  movingTimeS    Int
  distanceM      Float?
  elevationGainM Float?
  elevationLossM Float?
  avgHeartRate   Int?
  maxHeartRate   Int?
  avgPace        Float? // sec/km
  maxSpeed       Float? // m/s
  avgPower       Float? // watts (ciclismo)
  calories       Int?
  trainingLoad   Float?
  hrTSS          Float?

  summaryPolyline String? @db.Text // versão simplificada pra display

  visibility    String  @default("followers") // public | followers | clubs | private
  deviceSource  String? // phone, apple_watch, garmin_fenix, etc.
  rawPayloadRef String? // referência pra FIT/GPX original em S3

  startPrivacyRadiusM Int @default(250)
  endPrivacyRadiusM   Int @default(250)

  processingState String   @default("pending") // pending | processing | done | failed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  laps                 ActivityLap[]
  photos               ActivityPhoto[]
  segmentEfforts       SegmentEffort[]
  liveTrackingSessions LiveTrackingSession[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([sportType, startedAt])
}

model ActivityLap {
  id           String   @id @default(cuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  lapNumber    Int
  startedAt    DateTime
  elapsedTimeS Int
  distanceM    Float?
  avgPace      Float?
  avgHeartRate Int?
}

model ActivityPhoto {
  id         String    @id @default(cuid())
  activityId String
  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  imageUrl   String
  takenAt    DateTime?
  latitude   Float?
  longitude  Float?
}

model Route {
  id             String   @id @default(cuid())
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id])
  name           String
  sportType      String
  distanceM      Float
  elevationGainM Float
  polyline       String   @db.Text
  visibility     String   @default("public")
  source         String? // imported_gpx | created | suggested
  createdAt      DateTime @default(now())

  routePoints RoutePoint[]

  @@index([ownerId])
  @@index([sportType])
}

model RoutePoint {
  id        String @id @default(cuid())
  routeId   String
  route     Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sequence  Int
  latitude  Float
  longitude Float
  altitudeM Float?

  @@unique([routeId, sequence])
}

model Segment {
  id                String   @id @default(cuid())
  name              String
  sportType         String
  polyline          String   @db.Text
  distanceM         Float
  elevationGainM    Float
  visibility        String   @default("public")
  verificationState String   @default("auto") // auto | community | reviewed | rejected
  geomHash          String? // hash da geometria pra dedup
  createdAt         DateTime @default(now())

  efforts SegmentEffort[]

  @@index([sportType])
  @@index([geomHash])
}

model SegmentEffort {
  id           String   @id @default(cuid())
  segmentId    String
  segment      Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  athleteId    String
  athlete      User     @relation(fields: [athleteId], references: [id])
  elapsedMs    Int // tempo em ms
  startedAt    DateTime
  avgHeartRate Int?
  avgPower     Float?
  rankType     String   @default("user") // user | club | local | global
  flaggedFraud Boolean  @default(false)

  @@index([segmentId, elapsedMs])
  @@index([athleteId])
}

model Club {
  id           String   @id @default(cuid())
  ownerId      String
  name         String
  description  String?  @db.Text
  sportScope   String? // all | running | cycling | tennis | padel ...
  privacyLevel String   @default("public") // public | private | invite_only
  city         String?
  state        String?
  country      String   @default("BR")
  // Vinculação opcional à loja Sports & Tennis (clubes patrocinados/eventos)
  storeId      String?
  createdAt    DateTime @default(now())

  memberships ClubMembership[]

  @@index([city])
  @@index([sportScope])
  @@index([storeId])
}

model ClubMembership {
  id       String   @id @default(cuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member") // owner | admin | member
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
}

model Challenge {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  ruleType    String // distance | time | elevation | streak | social | purchase
  ruleConfig  Json // { target_distance_m, target_streak_days, target_cashback, ... }
  startsAt    DateTime
  endsAt      DateTime
  prizeType   String? // badge | premium_month | merch | teniscash | discount_coupon
  prizeValue  Float? // valor em TenisCash ou desconto se prizeType bater
  sponsorId   String? // ID de marca / fornecedor patrocinador
  visibility  String   @default("public")
  createdAt   DateTime @default(now())

  participations ChallengeParticipation[]
}

model ChallengeParticipation {
  id            String    @id @default(cuid())
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressValue Float     @default(0) // depende do ruleType
  completedAt   DateTime?
  joinedAt      DateTime  @default(now())

  @@unique([challengeId, userId])
}

model TrainingPlan {
  id            String   @id @default(cuid())
  goalType      String // 5k, 10k, 21k, 42k, tennis_endurance, padel_strength, custom
  level         String // beginner | intermediate | advanced
  durationWeeks Int
  authorId      String?
  version       String   @default("1.0")
  isOfficial    Boolean  @default(false)
  createdAt     DateTime @default(now())

  workouts  Workout[]
  userPlans UserPlan[]
}

model Workout {
  id              String       @id @default(cuid())
  planId          String
  plan            TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekNumber      Int
  dayOfWeek       Int // 1-7
  workoutType     String // easy | tempo | intervals | long | rest | cross
  targetDistanceM Float?
  targetDurationS Int?
  description     String?      @db.Text

  steps WorkoutStep[]
}

model WorkoutStep {
  id          String  @id @default(cuid())
  workoutId   String
  workout     Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sequence    Int
  stepType    String // warmup | main | recovery | cooldown
  durationS   Int?
  distanceM   Float?
  targetZone  String? // Z1 | Z2 | Z3 | Z4 | Z5
  repetitions Int?

  @@unique([workoutId, sequence])
}

model UserPlan {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  plan           TrainingPlan @relation(fields: [planId], references: [id])
  startedAt      DateTime
  endsAt         DateTime
  status         String       @default("active") // active | completed | abandoned
  adherenceScore Float? // 0-100 % de aderência
}

model SafetyContact {
  id               String  @id @default(cuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  phone            String?
  email            String?
  relationship     String?
  notifyOnLive     Boolean @default(true)
  notifyOnDistress Boolean @default(true)
}

model LiveTrackingSession {
  id             String    @id @default(cuid())
  activityId     String
  activity       Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User      @relation("liveTrackingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  shareTokenHash String    @unique // hash do token, NÃO o token cru
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  viewerCount    Int       @default(0)

  @@index([expiresAt])
}

model BadgeEarned {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey        String // "5k_club", "marathon", "100km_month", "first_purchase_apex", ...
  earnedAt        DateTime @default(now())
  xpAwarded       Int      @default(0)
  // TenisCash creditado por badge (loop economia loja↔app)
  cashbackAwarded Float    @default(0)
  metadata        Json?

  @@unique([userId, badgeKey])
}

// ============================================================
// FISCAL — Emissor de NF-e / NFC-e / CT-e via Brasil NFe API
// ============================================================

// 1 row por CNPJ emissor (Sports & Tennis, Meta Esportes, Meta Fardamentos, etc.)
model FiscalIssuer {
  id              String   @id @default(cuid())
  cnpj            String   @unique
  companyName     String
  fantasyName     String?
  ie              String?  // Inscrição Estadual
  im              String?  // Inscrição Municipal
  // Endereço (necessário pra cabeçalho NFe)
  street          String?
  number          String?
  complement      String?
  neighborhood    String?
  cityCode        String?  // código IBGE 7 dígitos
  city            String?
  state           String?  // UF — PB
  zip             String?
  phone           String?
  // Brasil NFe credenciais (homologação OU produção)
  apiToken        String?  // token de API por CNPJ
  environment     String   @default("homologation") // "homologation" | "production"
  // Códigos NFCe
  csc             String?  // Código de Segurança do Contribuinte
  cscId           String?  // ID do CSC (1, 2, 3...)
  // Regime tributário
  crt             Int      @default(1) // 1=Simples Nacional, 2=SN excesso receita, 3=Regime Normal
  // Numeração — controle interno
  nfeSerie        Int      @default(1)
  nfeNextNumber   Int      @default(1)
  nfceSerie       Int      @default(1)
  nfceNextNumber  Int      @default(1)
  cteSerie        Int      @default(1)
  cteNextNumber   Int      @default(1)
  // Status
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documents       FiscalDocument[]
  stores          Store[]

  @@index([cnpj])
  @@index([active])
}

// 1 row por documento fiscal emitido
model FiscalDocument {
  id              String   @id @default(cuid())
  issuerId        String
  issuer          FiscalIssuer @relation(fields: [issuerId], references: [id])

  // Tipo do documento
  docType         String   // "NFE" | "NFCE" | "CTE" | "MDFE" | "NFSE"
  serie           Int
  number          Int
  // Identificadores SEFAZ
  accessKey       String?  // 44 dígitos
  protocol        String?  // protocolo de autorização SEFAZ
  // Status fiscal
  status          String   @default("draft") // draft | processing | authorized | rejected | cancelled | error
  rejectReason    String?  // motivo de rejeição (se status=rejected)

  // Brasil NFe id interno (pra consultas/cancelamento via API)
  externalId      String?  @unique

  // Conteúdo
  recipientName   String?
  recipientCnpjCpf String?
  recipientEmail  String?
  totalValue      Float?
  productsValue   Float?
  discountValue   Float?
  freightValue    Float?

  // Vínculos com sistema TenisCash
  saleId          String?  // se foi gerado por uma venda
  productIds      String[] // produtos vendidos (Json array)

  // Dados de pagamento (Decreto SEFAZ-PB 43.077/2022)
  paymentMethod   String?  // tPag: 01=Dinheiro, 03=Crédito, 04=Débito, 17=PIX
  paymentBrand    String?  // tBand: 01=Visa, 02=Master, etc
  paymentAcquirer String?  // CNPJ da adquirente (Stone, Cielo, etc)
  paymentAuthCode String?  // cAut: código de autorização da maquininha
  paymentTpIntegra Int?    // 1=TEF integrado, 2=POS standalone

  // Documentos baixados/cacheados
  xmlContent      String?  @db.Text // XML autorizado
  danfeUrl        String?  // URL do DANFE PDF
  pdfContent      Bytes?   // PDF DANFE (cache, opcional)

  // Cancelamento (até 24h)
  cancelledAt     DateTime?
  cancelReason    String?
  cancelProtocol  String?

  // Carta de correção
  correctionLetter Json? // { sequence, reason, protocol, date }

  // Auditoria
  payload         Json? // requisição enviada à Brasil NFe (pra debug)
  response        Json? // resposta completa da Brasil NFe
  emittedById     String? // userId do operador
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([issuerId, docType, serie, number])
  @@index([accessKey])
  @@index([saleId])
  @@index([status])
  @@index([createdAt])
}

// Log de webhooks recebidos da Brasil NFe (status updates)
model FiscalWebhookLog {
  id              String   @id @default(cuid())
  externalId      String?  // id Brasil NFe
  event           String   // "authorized" | "rejected" | "cancelled" etc
  payload         Json
  processed       Boolean  @default(false)
  error           String?
  receivedAt      DateTime @default(now())

  @@index([externalId])
  @@index([receivedAt])
}
