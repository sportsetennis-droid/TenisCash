  relatedStoreId    String?
  relatedProductId  String?
  relatedCustomerId String?
  relatedSellerId   String?
  relatedCampaignId String?
  status            String    @default("OPEN") // OPEN | IN_REVIEW | ACTION_CREATED | RESOLVED | ARCHIVED
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  @@index([status, priority])
  @@index([type, status])
  @@index([createdAt])
}

// ============================================================
// CICLO DE VIDA DE PRODUTO (extensão do Product atual)
// ============================================================

model ProductLifecycle {
  id                 String    @id @default(cuid())
  productId          String    @unique
  storeId            String?
  launchDate         DateTime?
  purchaseDate       DateTime?
  stockEntryDate     DateTime?
  storeEntryDate     DateTime?
  firstSaleDate      DateTime?
  lastSaleDate       DateTime?
  soldOutDate        DateTime?
  lifecycleStatus    String    @default("NEW") // NEW | TESTING | FAST_TURNOVER | NORMAL_TURNOVER | SLOW_TURNOVER | STUCK | CLEARANCE | SOLD_OUT | REBUY | DO_NOT_REBUY
  daysUntilFirstSale Int?
  daysToSellOut      Int?
  daysInStock        Int?
  lastEvaluatedAt    DateTime  @default(now())
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([lifecycleStatus])
  @@index([storeId, lifecycleStatus])
}

// ============================================================
// FORNECEDORES (TenisCash OS — separado do Partner do programa)
// ============================================================

// ============================================================
// CATEGORIAS — árvore hierárquica (4 níveis)
//   CATEGORY → SUBCATEGORY → MODALITY → SPECIALTY
// Cada nível mapeia em campos do Product:
//   CATEGORY    → Product.category
//   SUBCATEGORY → Product.subcategory (gênero: Feminino/Homem/etc, ou "Tamanhos")
//   MODALITY    → Product.aiContext.classification.modality
//   SPECIALTY   → Product.aiContext.classification.tier
// ============================================================
model CategoryNode {
  id        String         @id @default(cuid())
  parentId  String?
  parent    CategoryNode?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  CategoryNode[] @relation("CategoryTree")
  name      String
  level     String // CATEGORY | SUBCATEGORY | MODALITY | SPECIALTY
  position  Int            @default(0) // ordenação manual dentro do mesmo nível
  active    Boolean        @default(true)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([parentId, position])
  @@index([level, active])
}

model Supplier {
  id                  String   @id @default(cuid())
  companyName         String
  cnpj                String?  @unique
  representativeName  String?
  phone               String?
  email               String?
  suppliedBrands      Json?
  commercialTerms     String?
  averageMarkup       Float?
  paymentDeadline     Int?
  notes               String?
  profitabilityRating Int? // 1..5
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([active])
}

// ============================================================
// FINANCEIRO (contas a pagar / receber)
// ============================================================

model AccountPayable {
  id          String    @id @default(cuid())
  supplierId  String?
  description String
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  status      String    @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  category    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, dueDate])
  @@index([supplierId])
}

model AccountReceivable {
  id           String    @id @default(cuid())
  customerId   String?
  saleId       String?
  description  String
  amount       Float
  dueDate      DateTime
  receivedDate DateTime?
  status       String    @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  category     String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, dueDate])
  @@index([customerId])
}

// ============================================================
// CAMPANHAS (marketing/ativação)
// ============================================================

model Campaign {
  id               String    @id @default(cuid())
  name             String
  channel          String? // INSTAGRAM | WHATSAPP | LOJA_FISICA | NUVEMSHOP | MIX
  storeId          String?
  budget           Float?
  startDate        DateTime?
  endDate          DateTime?
  generatedRevenue Float     @default(0)
  roi              Float?
  status           String    @default("DRAFT") // DRAFT | ACTIVE | FINISHED | CANCELLED
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customers CampaignCustomer[]
  products  CampaignProduct[]

  @@index([status, startDate])
  @@index([storeId])
}

model CampaignCustomer {
