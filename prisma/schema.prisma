generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUÁRIOS (clientes + vendedores + admins)
// ============================================================

model User {
  id              String    @id @default(uuid())
  name            String
  phone           String    @unique
  email           String?
  cpf             String?   @unique
  username        String?   @unique // handle único pra ser convidado em timelines privadas
  pin             String // hashed
  balance         Float     @default(0) // CASHBACK do cliente — pode transferir, usar em compras
  partnerBalance  Float     @default(0) // COMISSÃO do parceiro — APENAS troca por produtos (não transfere)
  role            String    @default("user") // user, seller, admin, superadmin, partner
  active          Boolean   @default(true)
  welcomeBonus    Boolean   @default(false)
  deletedCpf      String?
  profileComplete Boolean   @default(false)
  lgpdAccepted    Boolean   @default(false)
  lgpdDate        DateTime?

  // Dados pessoais
  birthDate    String?
  cep          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?

  // Dados físicos
  height    String?
  weight    String?
  shirtSize String?
  shoeSize  String?

  // CRM Esportivo (cliente)
  sportsPractice String?
  sportsWant     String?
  sportsWhere    String?
  favBrands      String?

  // Dados do vendedor (apenas role=seller)
  storeId      String? // loja PRINCIPAL (default no login pessoal)
  store        Store?    @relation(fields: [storeId], references: [id])
  storeIds     String[]  @default([]) // TODAS as lojas onde o vendedor atua (multi-loja); inclui a principal
  hireDate     DateTime?
  baseSalary   Float?
  employeeCode String?   @unique // V001, V002, etc

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations existentes
  sentTransfers     Transaction[] @relation("sender")
  receivedTransfers Transaction[] @relation("receiver")
  adminActions      AdminAction[]

  // Relations vendedor
  clockIns                       ClockIn[]                          @relation("clockIns")
  clockSummaries                 ClockSummary[]                     @relation("clockSummaries")
  walletEntries                  SellerWallet[]                     @relation("walletEntries")
  sellerClients                  SellerClient[]                     @relation("sellerClients")
  sales                          Sale[]                             @relation("sellerSales")
  customerSales                  Sale[]                             @relation("customerSales")
  commissions                    SaleCommission[]                   @relation("commissions")
  relationshipJourneysAsSeller   SellerCommissionJourney[]          @relation("relationshipJourneySeller")
  relationshipJourneysAsCustomer SellerCommissionJourney[]          @relation("relationshipJourneyCustomer")
  productionDaysAsSeller         SellerProductionDay[]              @relation("productionDaySeller")
  productionDaysFinalized        SellerProductionDay[]              @relation("productionDayFinalizer")
  productionItemsReviewed        SellerProductionItem[]             @relation("productionItemReviewer")
  productionMonthsAsSeller       SellerProductionMonth[]            @relation("productionMonthSeller")
  productionMonthsFinalized      SellerProductionMonth[]            @relation("productionMonthFinalizer")
  productionIncidentsAsSeller    SellerComplianceIncident[]         @relation("productionIncidentSeller")
  productionIncidentsDecided     SellerComplianceIncident[]         @relation("productionIncidentDecider")
  productionPolicyAcceptances    SellerProductionPolicyAcceptance[]
  productionRemindersReceived    SellerProductionReminder[]         @relation("productionReminderSeller")
  internalRequestsAsSeller       SellerInternalRequest[]            @relation("internalRequestSeller")
  internalRequestsReviewed       SellerInternalRequest[]            @relation("internalRequestReviewer")
  conductReportsSubmitted        SellerConductReport[]              @relation("conductReportReporter")
  conductReportsReviewed         SellerConductReport[]              @relation("conductReportReviewer")
  privateRecordAccesses          SellerPrivateAccessLog[]           @relation("privateAccessActor")
  messagesSent                   Message[]                          @relation("messagesSent")
  messagesReceived               Message[]                          @relation("messagesReceived")
  tasksCreated                   Task[]                             @relation("tasksCreated")
  tasksAssigned                  Task[]                             @relation("tasksAssigned")
  taskExecutions                 TaskExecution[]                    @relation("taskExecutions")
  trainings                      SellerTraining[]                   @relation("trainings")
  quizAttempts                   QuizAttempt[]                      @relation("quizAttempts")
  aiConversations                AIConversation[]                   @relation("aiConversations")
  productsCreated                Product[]                          @relation("productsCreated")

  // Programa de Parceiros
  partner              Partner?      @relation("partner")
  partnerSalesAsSeller PartnerSale[] @relation("partnerSaleSeller")

  // Resgate de TenisCash como desconto na loja Nuvemshop
  cashbackRedemptions CashbackRedemption[] @relation("cashbackRedemptions")

  // ===== APEX SPORT (app esportivo unificado ao TenisCash) =====
  // O cliente da loja Sports & Tennis é o mesmo atleta do app.
  // Ele compra na loja, treina no app, ganha TenisCash, gasta na próxima compra.
  athleteProfile          AthleteProfile?
  deviceConnections       DeviceConnection[]
  activities              Activity[]
  routes                  Route[]
  segmentEfforts          SegmentEffort[]
  clubMemberships         ClubMembership[]
  challengeParticipations ChallengeParticipation[]
  userPlans               UserPlan[]
  safetyContacts          SafetyContact[]
  badges                  BadgeEarned[]
  consents                Consent[]
  liveTrackingSessions    LiveTrackingSession[]    @relation("liveTrackingOwner")

  // ===== MENSAGENS V2 (Timeline + Conversas) =====
  timelinesCreated      Timeline[]       @relation("timelinesCreated")
  timelineMemberships   TimelineMember[] @relation("timelineMemberships")
  timelinePostsAuthored TimelinePost[]   @relation("timelinePostsAuthored")
  conversationsAsUserA  Conversation[]   @relation("conversationsAsUserA")
  conversationsAsUserB  Conversation[]   @relation("conversationsAsUserB")
  conversationsAsClient Conversation[]   @relation("conversationsAsClient")
  chatMessagesSent      ChatMessage[]    @relation("chatMessagesSent")
  reactions             Reaction[]       @relation("reactionsByUser")

  // Push notifications (Web Push API) — array de subscriptions (1 por device)
  pushSubscriptions PushSubscription[] @relation("pushByUser")

  // ===== PROFISSIONAL ESPORTIVO (card público + gestão + cobrança) =====
  // O usuário vira "profissional" (personal, professor, fisio, nutri).
  // Ele cobra pelos serviços DENTRO do app mesmo recebendo o dinheiro FORA
  // dele (Pix/banco próprio) — settlementMode separa COBRAR de RECEBER.
  professionalProfile     Professional?
  professionalClientLinks ProfessionalClient[]

  // ===== INFOPRODUTOS (plataforma estilo Hotmart) =====
  infoEnrollments Enrollment[] @relation("infoEnrollments")
  infoAffiliate   Affiliate?   @relation("infoAffiliate")

  // ===== APEX COMPETIÇÃO (torneios, ranking, desafios) =====
  tournamentsOwned   Tournament[]    @relation("tournamentOwner")
  entryMemberships   EntryMember[]
  athleteRatings     AthleteRating[]
  challengesSent     PlayChallenge[] @relation("challenger")
  challengesReceived PlayChallenge[] @relation("challenged")

  // ===== LOGIN BIOMÉTRICO (WebAuthn — Face ID / digital / Windows Hello) =====
  webauthnCredentials WebauthnCredential[]
  faceDescriptors     FaceDescriptor[]

  // ===== AGENDA / ESCALA DA EQUIPE (gerente monta dias × loja do vendedor) =====
  schedules                 SellerSchedule[]               @relation("sellerSchedules")
  agendaActivities          AgendaActivity[]               @relation("sellerActivities")
  monthlyScheduleShifts     SellerMonthlyShift[]           @relation("monthlyScheduleSeller")
  monthlySchedulesCreated   SellerMonthlySchedule[]        @relation("monthlyScheduleCreator")
  monthlySchedulesPublished SellerMonthlySchedule[]        @relation("monthlySchedulePublisher")
  monthlyScheduleReceipts   SellerMonthlyScheduleReceipt[] @relation("monthlyScheduleReceiptSeller")
}

// Passkeys/biometria do aparelho (FIDO2). O sistema NÃO guarda biometria — só a
// chave pública. Quem confirma "é você" é o próprio dispositivo. Senha continua como fallback.
model WebauthnCredential {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique // base64url do credential ID
  publicKey    Bytes // chave pública COSE
  counter      Int       @default(0)
  transports   String? // csv: internal,hybrid,usb...
  deviceLabel  String? // ex "iPhone do João"
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// Reconhecimento facial pela CÂMERA (face-api) — alternativa universal ao Face ID nativo,
// pra aparelhos SEM biometria de hardware. Guarda só o "descriptor" (128 números do rosto),
// NUNCA a foto. Menos seguro que Face ID (câmera 2D pode ser enganada por foto) — só onde o dono aceitar.
model FaceDescriptor {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  descriptor Float[] // 128 floats do face-api (NÃO é a imagem)
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// ============================================================
// MODELOS EXISTENTES (sem alteração)
// ============================================================

model Transaction {
  id          String @id @default(uuid())
  type        String
  amount      Float
  description String

  senderId String?
  sender   User?   @relation("sender", fields: [senderId], references: [id])

  receiverId String?
  receiver   User?   @relation("receiver", fields: [receiverId], references: [id])

  balanceAfter Float?
  metadata     String?

  createdAt DateTime @default(now())
}

model Promo {
  id          String    @id @default(uuid())
  title       String
  description String
  percentage  Float
  scope       String
  scopeValue  String?
  active      Boolean   @default(true)
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BrandRule {
  id          String   @id @default(uuid())
  brand       String   @unique
  maxDiscount Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Config {
  id    String @id @default("global")
  key   String @unique
  value String
}

model AdminAction {
  id           String   @id @default(uuid())
  adminId      String
  admin        User     @relation(fields: [adminId], references: [id])
  action       String
  targetUserId String?
  amount       Float?
  description  String
  metadata     String?
  createdAt    DateTime @default(now())
}

// ============================================================
// MÓDULO 0 — LOJAS
// ============================================================

model Store {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  dna          String? // Masculino, Feminino, Futebol, Geral
  mall         String? // Parahyba Mall, Pirâmide, Complexo K, Tambiá
  address      String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  cep          String?
  phone        String?
  latitude     Float?
  longitude    Float?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Nuvemshop: location_id físico desta loja (estoque por loja no site)
  nuvemshopLocationId String?

  // CNPJ que emite NFCe/NFe pelas vendas dessa loja
  fiscalIssuerId String?
  fiscalIssuer   FiscalIssuer? @relation(fields: [fiscalIssuerId], references: [id])

  // TenisCash Fiscal Agent — agente local que assina/envia NFCe usando o PFX
  // físico da máquina da loja. Quando enabled, central roteia /emit-nfce
  // via Tailscale em vez de tentar emitir do Railway.
  fiscalAgentUrl     String? // ex: "http://100.91.132.63:8765"
  fiscalAgentToken   String? // shared secret, header X-Agent-Token
  fiscalAgentEnabled Boolean @default(false)

  // PagBank (PIX QR por loja) — conta PagBank do CNPJ desta loja.
  // SEGREDO: mesmo padrão do fiscalAgentToken (só no banco, nunca no código).
  // Setado por scripts/pagbank-register-store.js (rodado na matriz).
  pagbankToken   String? // Bearer da conta PagBank DESTA loja (define pra qual conta o PIX cai)
  pagbankPixKey  String? // chave PIX ativa da conta (referência/auditoria)
  pagbankSandbox Boolean @default(true) // sandbox vs produção
  pagbankEnabled Boolean @default(false) // liga o fluxo PIX-QR automático nessa loja

  sellers        User[]
  clockIns       ClockIn[]
  messages       Message[]            @relation("storeMessages")
  stocks         StoreStock[]
  stockMovements StoreStockMovement[]

  // Mensagens V2: conversas entre loja e cliente
  conversationsAsStore Conversation[] @relation("conversationsForStore")

  // Agenda / escala da equipe
  schedules              SellerSchedule[]           @relation("storeSchedules")
  agendaActivities       AgendaActivity[]           @relation("storeActivities")
  monthlyScheduleShifts  SellerMonthlyShift[]       @relation("monthlyScheduleStore")
  productionDays         SellerProductionDay[]
  productionIncidents    SellerComplianceIncident[]
  productionReminders    SellerProductionReminder[]
  sellerInternalRequests SellerInternalRequest[]
  sellerConductReports   SellerConductReport[]
}

// ============================================================
// MÓDULO 1 — PONTO DIGITAL
// ============================================================

model ClockIn {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("clockIns", fields: [userId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  type      String // entry, break_start, break_end, exit
  timestamp DateTime @default(now())
  latitude  Float?
  longitude Float?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, timestamp])
}

model ClockSummary {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("clockSummaries", fields: [userId], references: [id])
  date            DateTime
  totalMinutes    Int
  breakMinutes    Int      @default(0)
  overtimeMinutes Int      @default(0)
  status          String   @default("normal")
  createdAt       DateTime @default(now())

  @@unique([userId, date])
}

// ============================================================
// MÓDULO 2 — CARTEIRA DO VENDEDOR
// ============================================================

model SellerWallet {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("walletEntries", fields: [userId], references: [id])
  type        String // salary, commission, vt, vr, bonus, overtime, deduction, advance
  amount      Float
  description String
  reference   String? // "2026-04"
  metadata    String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, reference])
}

// ============================================================
// MÓDULO 3 — CATÁLOGO
// ============================================================

model Product {
  id          String  @id @default(uuid())
  sku         String  @unique
  name        String
  brand       String
  category    String // tenis, roupa, acessorio
  subcategory String?

  shortDescription  String?
  longDescription   String?
  features          Json?
  aiContext         Json?
  recommendedFor    Json?
  notRecommendedFor Json?

  imageUrl  String?
  imageUrls Json?
  videoUrl  String? // vídeo do produto (MP4 no volume, servido por /media/product-video). Só loja TenisCash, NÃO vai pro Nuvemshop.

  price         Float
  promoPrice    Float?
  costPrice     Float? // custo unitário (média ponderada das NF-es). Usado pra calcular preço via markup.
  markupPercent Float? // override por produto. null = herda markup do Supplier (averageMarkup).

  // Fiscal — usado na emissão de NFe/NFCe (campos obrigatórios pela SEFAZ)
  ncm     String? // NCM (Nomenclatura Comum do Mercosul) — 8 dígitos
  cest    String? // CEST (substituição tributária) — opcional
  origem  Int     @default(0) // 0=Nacional, 1=Importação direta, 2=Importação adq merc nac, ...
  cfop    String? // CFOP padrão — sobrescreve o do issuer se preenchido (formato 4 dígitos)
  unidade String  @default("UN") // unidade de medida fiscal

  active   Boolean @default(true)
  featured Boolean @default(false)
  source   String  @default("manual") // manual, csv, ai

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("productsCreated", fields: [createdById], references: [id])

  sizes     ProductSize[]
  saleItems SaleItem[]
  trainings SellerTraining[]
  quizzes   Quiz[]

  // Mensagens V2: card de produto enviado em conversa
  chatMessagesAsCard  ChatMessage[]  @relation("chatMessageProducts")
  timelinePostsAsCard TimelinePost[] @relation("timelinePostProducts")

  // Marketing IA: criativos gerados (foto editorial, vídeo Reels, sem-fundo)
  creatives ProductCreative[] @relation("creativesForProduct")

  @@index([brand, category])
  @@index([active, featured])
}

model AIConversation {
  id         String  @id @default(uuid())
  userId     String?
  user       User?   @relation("aiConversations", fields: [userId], references: [id])
  userType   String // seller, client, guest
  sessionKey String? // identifica convidado (UUID do cliente) p/ limite diário

  title    String?
  messages Json    @default("[]")

  totalTokensIn  Int   @default(0)
  totalTokensOut Int   @default(0)
  totalCostBRL   Float @default(0)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
  @@index([sessionKey])
}

model ProductSize {
  id              String    @id @default(uuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  size            String
  stock           Int       @default(0) // estoque AGREGADO (legado) — fonte da verdade vira StoreStock
  barcode         String?
  // Tamanho CONFIRMADO por leitura da CAIXA física (fluxo manual do bipe).
  // null = veio de NFe/import/chute — pra Adidas, o bipe pede confirmação.
  // Caixa VENCE chute: tamanho confirmado nunca é remanejado por conflito.
  sizeConfirmedAt DateTime?

  storeStocks    StoreStock[]
  saleItems      SaleItem[]
  stockMovements StoreStockMovement[]

  @@unique([productId, size])
}

// Estoque por loja — fonte da verdade. Cada (loja, tamanho) tem uma linha.
model StoreStock {
  id            String      @id @default(uuid())
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id])
  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  stock         Int         @default(0)
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())

  @@unique([storeId, productSizeId])
  @@index([storeId])
  @@index([productSizeId])
}

// ============================================================
// MÓDULO 4 — CRM DO VENDEDOR
// ============================================================

model SellerClient {
  id            String    @id @default(uuid())
  sellerId      String
  seller        User      @relation("sellerClients", fields: [sellerId], references: [id])
  tcUserId      String?
  name          String
  phone         String?
  email         String?
  cpf           String?
  birthDate     String?
  address       String?
  city          String?
  state         String?
  height        String?
  weight        String?
  shirtSize     String?
  shoeSize      String?
  notes         String?
  tags          String?
  lastPurchase  DateTime?
  totalSpent    Float     @default(0)
  purchaseCount Int       @default(0)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sales Sale[]

  @@index([sellerId])
  @@index([birthDate])
}

// ============================================================
// MÓDULO 5 — VENDAS
// ============================================================

model Sale {
  id             String        @id @default(uuid())
  sellerId       String
  seller         User          @relation("sellerSales", fields: [sellerId], references: [id])
  customerUserId String?
  customerUser   User?         @relation("customerSales", fields: [customerUserId], references: [id], onDelete: SetNull)
  clientId       String?
  client         SellerClient? @relation(fields: [clientId], references: [id])
  storeId        String?
  totalAmount    Float
  discount       Float         @default(0) // desconto em R$ aplicado na venda (já embutido no totalAmount líquido)
  tcUsed         Float         @default(0)
  tcEarned       Float         @default(0)
  paymentMethod  String?
  status         String        @default("completed")
  erpReference   String?
  pagbankOrderId String? // PagBank order id (ORDE_...) do PIX-QR; webhook mapeia por aqui
  note           String?
  idemKey        String?       @unique // anti-duplicação: 1 venda por chave do carrinho (trava durável no banco)
  createdAt      DateTime      @default(now())

  items                   SaleItem[]
  commissions             SaleCommission[]
  stockMovements          StoreStockMovement[]
  relationshipJourney     SellerCommissionJourney? @relation("relationshipJourneySale")
  referralCommissionStage SellerCommissionStage?   @relation("referralConvertedSale")

  @@index([sellerId, createdAt])
  @@index([clientId])
  @@index([customerUserId, createdAt])
}

model SaleItem {
  id            String       @id @default(uuid())
  saleId        String
  sale          Sale         @relation(fields: [saleId], references: [id])
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])
  productSizeId String?
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id], onDelete: SetNull)
  productName   String
  brand         String
  category      String?
  size          String?
  quantity      Int          @default(1)
  unitPrice     Float
  totalPrice    Float
  unitCost      Float? // snapshot do custo unitario no momento da venda; null em vendas antigas

  stockMovements StoreStockMovement[]

  @@index([productSizeId])
}

// Livro razao do estoque fisico por loja. Cada venda/estorno deixa uma prova
// imutavel do delta e do saldo antes/depois. ProductSize.stock (COMPRADO) nao entra aqui.
model StoreStockMovement {
  id            String       @id @default(uuid())
  storeId       String?
  store         Store?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  productSizeId String?
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id], onDelete: SetNull)
  saleId        String?
  sale          Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  saleItemId    String?
  saleItem      SaleItem?    @relation(fields: [saleItemId], references: [id], onDelete: SetNull)
  type          String // sale | sale_cancel | exchange_sale | exchange_return | historical_backfill
  quantity      Int // delta assinado: venda=-1, estorno=+1
  stockBefore   Int
  stockAfter    Int
  source        String       @default("system")
  reason        String?
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@unique([saleItemId, type])
  @@index([storeId, createdAt])
  @@index([productSizeId, createdAt])
  @@index([saleId])
}

// ============================================================
// MÓDULO 6 — COMISSÕES
// ============================================================

model BrandCommission {
  id            String   @id @default(uuid())
  brand         String   @unique
  commissionPct Float
  bonusPct      Float?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SaleCommission {
  id         String    @id @default(uuid())
  saleId     String
  sale       Sale      @relation(fields: [saleId], references: [id])
  sellerId   String
  seller     User      @relation("commissions", fields: [sellerId], references: [id])
  brand      String
  saleAmount Float
  pct        Float
  amount     Float
  status     String    @default("pending")
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([sellerId, status])
}

// ============================================================
// COMISSAO POR CICLO DE RELACIONAMENTO
// A tela nunca apresenta IDs: organiza por cliente + valor pago + itens.
// IDs permanecem internos para impedir vinculos/estornos na venda errada.
// ============================================================

model SellerCommissionJourney {
  id                 String    @id @default(cuid())
  saleId             String    @unique
  sale               Sale      @relation("relationshipJourneySale", fields: [saleId], references: [id], onDelete: Cascade)
  sellerId           String
  seller             User      @relation("relationshipJourneySeller", fields: [sellerId], references: [id])
  customerUserId     String
  customer           User      @relation("relationshipJourneyCustomer", fields: [customerUserId], references: [id])
  storeId            String?
  customerName       String
  customerPhone      String?
  cycleNumber        Int
  purchasePosition   Int // 1 = primeira venda do ciclo; 2 = recompra
  baseAmount         Float // valor efetivamente pago: total liquido - TenisCash usado
  basePct            Float
  currentPct         Float
  earnedAmount       Float
  reversedAmount     Float     @default(0)
  status             String    @default("ACTIVE") // ACTIVE | COMPLETED | PENDING_PAYMENT | CANCELED
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  canceledAt         DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  stages SellerCommissionStage[]

  @@index([sellerId, status, createdAt])
  @@index([customerUserId, sellerId, createdAt])
  @@index([storeId, createdAt])
}

model SellerCommissionStage {
  id                 String                  @id @default(cuid())
  journeyId          String
  journey            SellerCommissionJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  key                String
  position           Int
  title              String
  targetPct          Float
  deltaPct           Float                   @default(0)
  amount             Float                   @default(0)
  status             String                  @default("PENDING") // PENDING | SUBMITTED | REJECTED | COMPLETED | REVERSED
  note               String?
  publicationUrl     String?
  evidenceUrl        String?
  customerInteracted Boolean                 @default(false)
  interactionChannel String?
  consentConfirmed   Boolean                 @default(false)
  completedById      String?
  completedAt        DateTime?
  submittedAt        DateTime?
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNote         String?
  referredSaleId     String?                 @unique
  referredSale       Sale?                   @relation("referralConvertedSale", fields: [referredSaleId], references: [id], onDelete: SetNull)
  reversedAt         DateTime?
  reversalReason     String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  evidence SellerCommissionEvidence[]

  @@unique([journeyId, key])
  @@index([journeyId, position])
  @@index([status, submittedAt])
}

model SellerCommissionEvidence {
  id           String                @id @default(cuid())
  stageId      String
  stage        SellerCommissionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  storedName   String                @unique
  originalName String
  mimeType     String
  mediaType    String // photo | video
  bytes        Int
  createdAt    DateTime              @default(now())

  @@index([stageId])
}

// ============================================================
// MÓDULO 7 — COMUNICAÇÃO INTERNA
// ============================================================

// ============================================================
// PRODUCAO DIARIA DO VENDEDOR
// Checklist diario com prova privada, fiscalizacao humana e fechamento mensal.
// O sistema registra elegibilidade e ocorrencias; nao aplica punicao trabalhista
// nem altera folha/contrato automaticamente.
// ============================================================

model SellerProductionDay {
  id            String    @id @default(cuid())
  sellerId      String
  seller        User      @relation("productionDaySeller", fields: [sellerId], references: [id])
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  workDate      DateTime
  policyVersion String    @default("ST-PRODUCAO-2026-07-V2")
  status        String    @default("OPEN") // OPEN | SUBMITTED | CHANGES_REQUIRED | APPROVED | NONCOMPLIANT | EXCUSED
  incentivePct  Float     @default(10)
  scheduleStart String?
  scheduleEnd   String?
  sellerNote    String?   @db.Text
  submittedAt   DateTime?
  finalizedById String?
  finalizedBy   User?     @relation("productionDayFinalizer", fields: [finalizedById], references: [id])
  finalizedAt   DateTime?
  finalNote     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items     SellerProductionItem[]
  incident  SellerComplianceIncident?
  reminders SellerProductionReminder[]

  @@unique([sellerId, workDate])
  @@index([storeId, workDate, status])
  @@index([sellerId, status, workDate])
}

model SellerProductionItem {
  id                        String              @id @default(cuid())
  dayId                     String
  day                       SellerProductionDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  ruleKey                   String
  phase                     String // ARRIVAL | FIRST_TURN | SECOND_TURN | EXIT
  position                  Int
  title                     String
  mediaType                 String // photo | video
  targetDurationSec         Int?
  requiredProducts          Int                 @default(0)
  status                    String              @default("PENDING") // PENDING | SUBMITTED | REJECTED | APPROVED | EXCUSED
  note                      String?             @db.Text
  publicationUrl            String?
  whatsappProofUrl          String?
  durationSeconds           Int?
  productRefs               String[]            @default([])
  requirementsConfirmedJson String?             @db.Text
  noInstagramStoryConfirmed Boolean             @default(false)
  submittedAt               DateTime?
  reviewedById              String?
  reviewedBy                User?               @relation("productionItemReviewer", fields: [reviewedById], references: [id])
  reviewedAt                DateTime?
  reviewNote                String?             @db.Text
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  evidence SellerProductionEvidence[]

  @@unique([dayId, ruleKey])
  @@index([dayId, position])
  @@index([status, submittedAt])
}

model SellerProductionEvidence {
  id           String               @id @default(cuid())
  itemId       String
  item         SellerProductionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind         String               @default("PRIMARY") // PRIMARY | WHATSAPP_PROOF | OTHER
  storedName   String               @unique
  originalName String
  mimeType     String
  mediaType    String // photo | video
  bytes        Int
  createdAt    DateTime             @default(now())

  @@index([itemId])
}

model SellerProductionPolicyAcceptance {
  id            String   @id @default(cuid())
  sellerId      String
  seller        User     @relation(fields: [sellerId], references: [id])
  policyVersion String
  policyDigest  String
  acceptedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([sellerId, policyVersion])
  @@index([policyVersion, acceptedAt])
}

model SellerProductionMonth {
  id                 String    @id @default(cuid())
  sellerId           String
  seller             User      @relation("productionMonthSeller", fields: [sellerId], references: [id])
  month              String // YYYY-MM no fuso America/Fortaleza
  incentivePct       Float     @default(10)
  status             String    @default("OPEN") // OPEN | ELIGIBLE | INELIGIBLE | NEEDS_REVIEW
  expectedDays       Int       @default(0)
  approvedDays       Int       @default(0)
  noncompliantDays   Int       @default(0)
  openDays           Int       @default(0)
  baseSalarySnapshot Float?
  eligibleAmount     Float?
  calculatedAt       DateTime?
  finalizedById      String?
  finalizedBy        User?     @relation("productionMonthFinalizer", fields: [finalizedById], references: [id])
  finalizedAt        DateTime?
  note               String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([sellerId, month])
  @@index([month, status])
}

model SellerComplianceIncident {
  id                String              @id @default(cuid())
  dayId             String              @unique
  day               SellerProductionDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  sellerId          String
  seller            User                @relation("productionIncidentSeller", fields: [sellerId], references: [id])
  storeId           String
  store             Store               @relation(fields: [storeId], references: [id])
  status            String              @default("AWAITING_RESPONSE") // AWAITING_RESPONSE | UNDER_REVIEW | CLOSED_NO_ACTION | DECIDED
  summary           String              @db.Text
  sellerResponse    String?             @db.Text
  respondedAt       DateTime?
  recommendedAction String              @default("MANUAL_REVIEW")
  decision          String? // NOTICE | WARNING | SUSPENSION_3_REVIEW | SUSPENSION_5_REVIEW | TERMINATION_REVIEW | NO_ACTION
  decisionReason    String?             @db.Text
  decidedById       String?
  decidedBy         User?               @relation("productionIncidentDecider", fields: [decidedById], references: [id])
  decidedAt         DateTime?
  acknowledgedAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([sellerId, status, createdAt])
  @@index([storeId, status, createdAt])
}

model SellerProductionReminder {
  id           String              @id @default(cuid())
  dayId        String
  day          SellerProductionDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       User                @relation("productionReminderSeller", fields: [sellerId], references: [id])
  storeId      String
  store        Store               @relation(fields: [storeId], references: [id])
  kind         String // DAY_START | MID_SHIFT | SHIFT_END
  pendingCount Int                 @default(0)
  messageId    String?
  sentAt       DateTime            @default(now())
  createdAt    DateTime            @default(now())

  @@unique([dayId, kind])
  @@index([sellerId, sentAt])
  @@index([storeId, sentAt])
}

model SellerInternalRequest {
  id              String    @id @default(cuid())
  sellerId        String
  seller          User      @relation("internalRequestSeller", fields: [sellerId], references: [id])
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id])
  category        String // SUPPLIES | MAINTENANCE | PRODUCT | EQUIPMENT | OTHER
  title           String
  description     String    @db.Text
  urgency         String    @default("NORMAL") // NORMAL | HIGH | URGENT
  status          String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | REJECTED
  companyResponse String?   @db.Text
  reviewedById    String?
  reviewedBy      User?     @relation("internalRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attachments SellerPrivateAttachment[]

  @@index([sellerId, status, createdAt])
  @@index([storeId, status, createdAt])
}

model SellerConductReport {
  id              String    @id @default(cuid())
  reporterId      String
  reporter        User      @relation("conductReportReporter", fields: [reporterId], references: [id])
  storeId         String?
  store           Store?    @relation(fields: [storeId], references: [id])
  category        String // OFFENSE | HARASSMENT | DISCRIMINATION | THREAT | MISCONDUCT | OTHER
  occurredAt      DateTime?
  involvedPerson  String?
  description     String    @db.Text
  status          String    @default("RECEIVED") // RECEIVED | UNDER_REVIEW | CLOSED
  companyResponse String?   @db.Text
  reviewedById    String?
  reviewedBy      User?     @relation("conductReportReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  attachments SellerPrivateAttachment[]

  @@index([reporterId, status, createdAt])
  @@index([status, createdAt])
}

model SellerPrivateAttachment {
  id           String                 @id @default(cuid())
  requestId    String?
  request      SellerInternalRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reportId     String?
  report       SellerConductReport?   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  storedName   String                 @unique
  originalName String
  mimeType     String
  mediaType    String // photo | video
  bytes        Int
  createdAt    DateTime               @default(now())

  @@index([requestId])
  @@index([reportId])
}

model SellerPrivateAccessLog {
  id           String   @id @default(cuid())
  actorId      String
  actor        User     @relation("privateAccessActor", fields: [actorId], references: [id])
  resourceType String // PRODUCTION_EVIDENCE | REQUEST_ATTACHMENT | CONDUCT_ATTACHMENT | CONDUCT_REPORT
  resourceId   String
  action       String   @default("VIEW")
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
}

model Message {
  id     String @id @default(uuid())
  fromId String
  from   User   @relation("messagesSent", fields: [fromId], references: [id])

  // Destinatário (pelo menos um deve estar preenchido)
  toId      String? // mensagem direta a um usuário (fan-out também usa isso)
  to        User?   @relation("messagesReceived", fields: [toId], references: [id])
  toStoreId String? // broadcast pra loja (apenas rastreio)
  toStore   Store?  @relation("storeMessages", fields: [toStoreId], references: [id])
  toAll     Boolean @default(false) // broadcast pra todas as lojas (apenas rastreio)

  // Tipo
  type String // 'message', 'demand', 'announcement', 'request'

  // Conteúdo
  title   String? // obrigatório pra demand/announcement/request
  content String

  // Demand fields
  priority String? // 'low', 'normal', 'high', 'urgent' (só pra demand)
  dueDate  DateTime? // só pra demand

  // Status
  status   String    @default("sent") // sent, read, doing, done, confirmed, replied, approved, rejected
  readAt   DateTime?
  doneAt   DateTime?
  doneById String?

  // Resposta (pra request)
  parentId     String?
  replyContent String?
  repliedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([toId, status])
  @@index([toStoreId, status])
  @@index([type, status])
}

model Channel {
  id          String   @id @default(uuid())
  name        String
  type        String
  storeId     String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ============================================================
// MÓDULO 8 — TAREFAS
// ============================================================

model Task {
  id           String    @id @default(uuid())
  title        String
  description  String?
  createdById  String
  createdBy    User      @relation("tasksCreated", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("tasksAssigned", fields: [assignedToId], references: [id])
  storeId      String?
  type         String    @default("once")
  priority     String    @default("normal")
  dueDate      DateTime?
  recurrence   String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  executions TaskExecution[]
}

model TaskExecution {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id])
  userId      String
  user        User     @relation("taskExecutions", fields: [userId], references: [id])
  date        DateTime
  status      String   @default("done")
  note        String?
  photoUrl    String?
  completedAt DateTime @default(now())

  @@index([taskId, date])
  @@index([userId, date])
}

// ============================================================
// MÓDULO 9 — TREINAMENTO + QUIZ
// ============================================================

model SellerTraining {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("trainings", fields: [userId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  topic       String
  type        String   @default("product")
  source      String?
  completedAt DateTime @default(now())
  score       Float?
  certified   Boolean  @default(false)
  metadata    String?

  @@index([userId])
}

model Quiz {
  id        String   @id @default(uuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  topic     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  questions QuizQuestion[]
}

model QuizQuestion {
  id           String  @id @default(uuid())
  quizId       String
  quiz         Quiz    @relation(fields: [quizId], references: [id])
  question     String
  options      String // JSON array
  correctIndex Int
  explanation  String?
  order        Int     @default(0)
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("quizAttempts", fields: [userId], references: [id])
  quizId      String
  answers     String // JSON
  score       Float
  passed      Boolean
  completedAt DateTime @default(now())

  @@index([userId, quizId])
}

// ============================================================
// MÓDULO 10 — PROGRAMA DE PARCEIROS (afiliados)
// ============================================================

model Partner {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("partner", fields: [userId], references: [id])

  type   String // 'atleta', 'influencer', 'saude', 'personal', 'outro'
  status String @default("active") // active, paused, banned

  couponCode    String  @unique // ex: PEDRO, CARLA-RUN
  discountPct   Float   @default(5) // % desconto pro cliente
  commissionPct Float   @default(5) // % comissão pro Creation
  nsCouponId    String? // id do cupom espelhado na Nuvemshop (interligação Creation ⇄ NS)

  // Estatísticas (denormalizadas pra dashboard rápido)
  totalSales      Int    @default(0)
  totalRevenue    Float  @default(0)
  totalCommission Float  @default(0)
  tier            String @default("bronze") // bronze, prata, ouro, platina

  // Info do parceiro
  bio         String?
  socialMedia String? // JSON
  followers   Int?
  niche       String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     PartnerSale[]
  campaigns CreationCampaign[]

  @@index([status])
  @@index([tier])
}

model PartnerSale {
  id        String  @id @default(uuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  customerName  String?
  customerCpf   String? // mascarado (apenas dígitos limpos)
  customerPhone String?

  saleAmount     Float // valor TOTAL da venda (após desconto)
  saleAmountFull Float // valor SEM desconto
  discountValue  Float // valor do desconto aplicado
  commissionT    Float // T$ que o parceiro ganhou

  products String? // JSON com produtos vendidos

  status   String  @default("approved") // approved, pending, refunded
  storeId  String?
  sellerId String? // vendedor que registrou a venda
  seller   User?   @relation("partnerSaleSeller", fields: [sellerId], references: [id])

  channel   String  @default("pdv") // pdv | nuvemshop
  nsOrderId String? // id do pedido Nuvemshop (idempotência da comissão online)

  createdAt DateTime @default(now())

  @@index([partnerId, createdAt])
  @@index([customerCpf, createdAt])
  @@index([nsOrderId])
}

// ============================================================
// MÓDULO 10.1 — CAMPANHAS DE CREATION (briefing + entregáveis + retainer)
// ============================================================
// Extensão do Programa de Parceiros (Partner = Creation). Contrata um Creation
// por CAMPANHA. Pagamento por:
//   - commission  → comissão de venda (já roda via cupom/PartnerSale)
//   - monthly_fee → valor mensal fixo (retainer)        ← novo
//   - hybrid      → retainer + comissão
// O retainer é pago via CreationPayout. payoutMode decide a moeda:
//   - tenis_cash → credita User.partnerBalance (T$, trocável por produto)
//   - pix_cash   → pagamento OFF-PLATFORM (Pix/banco), só registra liquidação
// (mesmo princípio COBRAR≠RECEBER do Charge dos Professionals).
model CreationCampaign {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  title     String
  briefing  String? @db.Text // roteiro/diretrizes do que o creator deve postar
  objective String? // awareness | sales | launch | ugc | other

  // Modelo de pagamento
  paymentModel          String @default("commission") // commission | monthly_fee | hybrid
  monthlyFee            Float  @default(0) // valor do retainer por período (na moeda do payoutMode)
  commissionPctOverride Float? // sobrescreve Partner.commissionPct nesta campanha (null = herda)
  payoutMode            String @default("tenis_cash") // tenis_cash | pix_cash

  // Período / recorrência do retainer
  recurrence String    @default("monthly") // one_off | monthly
  startDate  DateTime  @default(now())
  endDate    DateTime?
  dayOfMonth Int? // dia de fechamento/pagamento do retainer (1-28)

  // Entregáveis — ex: [{ "type": "reel", "qty": 3, "done": 1 }, { "type": "story", "qty": 5, "done": 0 }]
  deliverables Json?

  status String  @default("proposed") // proposed | active | paused | delivered | finished | cancelled
  notes  String?

  // Stats denormalizadas
  totalPaid Float @default(0) // soma dos payouts liquidados

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payouts CreationPayout[]

  @@index([partnerId, status])
  @@index([status])
}

model CreationPayout {
  id         String           @id @default(cuid())
  campaignId String
  campaign   CreationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  partnerId  String // denormalizado pra query rápida por parceiro

  reference  String // "2026-05" (competência do retainer) ou "one_off"
  amount     Float
  payoutMode String @default("tenis_cash") // snapshot do modo no momento da geração

  status   String    @default("pending") // pending | paid | cancelled
  method   String? // tenis_cash | pix | cash | transfer
  paidAt   DateTime?
  paidById String? // admin que liberou
  txId     String? // Transaction.id quando creditado em T$ (partnerBalance)

  notes     String?
  createdAt DateTime @default(now())

  @@unique([campaignId, reference]) // idempotência: 1 retainer por competência por campanha
  @@index([partnerId, status])
  @@index([status, createdAt])
}

// ============================================================
// RESGATE DE TENISCASH NA LOJA (cashback -> desconto Nuvemshop)
// ============================================================
// Cliente gera um cupom pessoal de valor (% do carrinho, teto = saldo).
// Aplica no checkout da NS. Quando o pedido é pago, debitamos o saldo
// pelo valor realmente descontado. Idempotente por nsOrderId.
model CashbackRedemption {
  id     String @id @default(uuid())
  userId String
  user   User   @relation("cashbackRedemptions", fields: [userId], references: [id])

  couponCode String  @unique // código pessoal gerado (ex: TC7H3K9Q)
  nsCouponId String? // id do cupom espelhado na Nuvemshop

  pct        Float // % aplicado no momento da geração (snapshot do teto config)
  maxAmount  Float // teto em R$ = saldo disponível na geração (max_discount_amount NS)
  usedAmount Float @default(0) // R$ efetivamente debitado quando consumido

  status     String    @default("pending") // pending | consumed | expired | cancelled
  nsOrderId  String? // pedido NS que consumiu (idempotência)
  expiresAt  DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, status])
  @@index([nsOrderId])
}

// ============================================================
// CAMADA DE AGENTES IA — Central IA Sports & Tennis
// ============================================================
// Modelos para o Orquestrador Central, agentes especialistas,
// aprovações humanas, logs de IA e Life Assessor.
// Nomenclatura técnica genérica para permitir evolução futura
// para ST Core / ST OS sem refactor estrutural.

model AIAgent {
