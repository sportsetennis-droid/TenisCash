  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  phone            String?
  email            String?
  relationship     String?
  notifyOnLive     Boolean @default(true)
  notifyOnDistress Boolean @default(true)
}

model LiveTrackingSession {
  id             String    @id @default(cuid())
  activityId     String
  activity       Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User      @relation("liveTrackingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  shareTokenHash String    @unique // hash do token, NÃO o token cru
  startedAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  viewerCount    Int       @default(0)

  @@index([expiresAt])
}

model BadgeEarned {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey        String // "5k_club", "marathon", "100km_month", "first_purchase_apex", ...
  earnedAt        DateTime @default(now())
  xpAwarded       Int      @default(0)
  // TenisCash creditado por badge (loop economia loja↔app)
  cashbackAwarded Float    @default(0)
  metadata        Json?

  @@unique([userId, badgeKey])
}

// ============================================================
// FISCAL — Emissor de NF-e / NFC-e / CT-e via Brasil NFe API
// ============================================================

// 1 row por CNPJ emissor (Sports & Tennis, Meta Esportes, Meta Fardamentos, etc.)
model FiscalIssuer {
  id             String   @id @default(cuid())
  cnpj           String   @unique
  companyName    String
  fantasyName    String?
  ie             String? // Inscrição Estadual
  im             String? // Inscrição Municipal
  // Endereço (necessário pra cabeçalho NFe)
  street         String?
  number         String?
  complement     String?
  neighborhood   String?
  cityCode       String? // código IBGE 7 dígitos
  city           String?
  state          String? // UF — PB
  zip            String?
  phone          String?
  // Brasil NFe credenciais (homologação OU produção)
  apiToken       String? // token de API por CNPJ
  environment    String   @default("homologation") // "homologation" | "production"
  // Códigos NFCe
  csc            String? // Código de Segurança do Contribuinte
  cscId          String? // ID do CSC (1, 2, 3...)
  // Regime tributário
  crt            Int      @default(1) // 1=Simples Nacional, 2=SN excesso receita, 3=Regime Normal
  // Numeração — controle interno
  nfeSerie       Int      @default(1)
  nfeNextNumber  Int      @default(1)
  nfceSerie      Int      @default(1)
  nfceNextNumber Int      @default(1)
  cteSerie       Int      @default(1)
  cteNextNumber  Int      @default(1)
  // Status
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documents FiscalDocument[]
  stores    Store[]

  @@index([cnpj])
  @@index([active])
}

// 1 row por documento fiscal emitido
model FiscalDocument {
  id       String       @id @default(cuid())
  issuerId String
  issuer   FiscalIssuer @relation(fields: [issuerId], references: [id])

  // Tipo do documento
  docType      String // "NFE" | "NFCE" | "CTE" | "MDFE" | "NFSE"
  serie        Int
  number       Int
  // Identificadores SEFAZ
  accessKey    String? // 44 dígitos
  protocol     String? // protocolo de autorização SEFAZ
  // Status fiscal
  status       String  @default("draft") // draft | processing | authorized | rejected | cancelled | error
  rejectReason String? // motivo de rejeição (se status=rejected)

  // Brasil NFe id interno (pra consultas/cancelamento via API)
  externalId String? @unique

  // Conteúdo
  recipientName    String?
  recipientCnpjCpf String?
  recipientEmail   String?
  totalValue       Float?
  productsValue    Float?
  discountValue    Float?
  freightValue     Float?

  // Vínculos com sistema TenisCash
  saleId     String? // se foi gerado por uma venda
  productIds String[] // produtos vendidos (Json array)

  // Dados de pagamento (Decreto SEFAZ-PB 43.077/2022)
  paymentMethod    String? // tPag: 01=Dinheiro, 03=Crédito, 04=Débito, 17=PIX
  paymentBrand     String? // tBand: 01=Visa, 02=Master, etc
  paymentAcquirer  String? // CNPJ da adquirente (Stone, Cielo, etc)
  paymentAuthCode  String? // cAut: código de autorização da maquininha
  paymentTpIntegra Int? // 1=TEF integrado, 2=POS standalone

  // Documentos baixados/cacheados
  xmlContent String? @db.Text // XML autorizado
  danfeUrl   String? // URL do DANFE PDF
  pdfContent Bytes? // PDF DANFE (cache, opcional)

  // Cancelamento (até 24h)
  cancelledAt    DateTime?
  cancelReason   String?
  cancelProtocol String?

  // Carta de correção
  correctionLetter Json? // { sequence, reason, protocol, date }

  // Auditoria
  payload     Json? // requisição enviada à Brasil NFe (pra debug)
  response    Json? // resposta completa da Brasil NFe
  emittedById String? // userId do operador
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([issuerId, docType, serie, number])
  @@index([accessKey])
  @@index([saleId])
  @@index([status])
  @@index([createdAt])
}

// Log de webhooks recebidos da Brasil NFe (status updates)
model FiscalWebhookLog {
  id         String   @id @default(cuid())
  externalId String? // id Brasil NFe
  event      String // "authorized" | "rejected" | "cancelled" etc
  payload    Json
  processed  Boolean  @default(false)
  error      String?
  receivedAt DateTime @default(now())

  @@index([externalId])
  @@index([receivedAt])
}

// =====================================================================
// CONTAGEM POR BIPE — registro de cada produto bipado em /bipar.html
// =====================================================================
// Endpoint público: POST /api/public/stocktake/bipe
// O vendedor seleciona loja + nome dele, bipa todos os produtos.
// Cada bipe vira UMA linha aqui. Owner consulta no admin pra cruzar
// com StoreStock e decidir o que fazer.
// =====================================================================
model StocktakeBipe {
  id            String   @id @default(cuid())
  barcode       String // código bipado, exato como veio do leitor
  storeId       String? // FK Store (opcional pra resiliencia)
  sellerId      String? // FK User (vendedor que bipou)
  sellerName    String? // nome legível guardado no momento do bipe (caso seller deletado depois)
  productId     String? // FK Product, null se barcode não achou produto
  productSizeId String? // FK ProductSize, null se não achou
  productName   String? // snapshot do nome
  productSize   String? // snapshot do tamanho
  productBrand  String? // snapshot da marca
  found         Boolean  @default(false) // true se localizou produto no catálogo
  duplicate     Boolean  @default(false) // true se o barcode existe em >1 produto (ambíguo)
  ip            String? // IP de quem bipou (auditoria)
  userAgent     String? // browser/dispositivo
  applied       Boolean  @default(false) // true depois que owner aplicou no StoreStock
  bipedAt       DateTime @default(now())

  @@index([storeId, bipedAt])
  @@index([sellerId, bipedAt])
  @@index([barcode])
  @@index([productId])
  @@index([applied, bipedAt])
}

// Fila de CONFERÊNCIA: produto bipado que NÃO foi reconhecido. A equipe bate
// foto -> entra aqui -> o dono/IA busca na NFe e monta o card (ou descarta).
model ProductCapture {
  id               String    @id @default(cuid())
  barcode          String? // código bipado (se houver)
  storeId          String?
  sellerId         String?
  sellerName       String?
  photo            String? // foto principal (data URL webp base64)
  photos           Json? // fotos extras (array de data URLs)
  note             String?
  status           String    @default("pendente") // pendente | em_nfe | vinculado | criado | descartado
  matchedProductId String? // casou com Product existente
  createdProductId String? // virou card novo
  nfeItemId        String? // XmlFiscalItem casado
  bipeId           String? // StocktakeBipe de origem
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  @@index([status, createdAt])
  @@index([barcode])
}

// =====================================================================
// MENSAGENS V2 — Timeline ("Como está o dia hoje?") + Conversas (DMs)
// =====================================================================
// Ver documento: docs/MENSAGENS.md
// Princípios:
// - Timeline some 00:00 (cron timezone America/Fortaleza)
// - Conversas persistem PRA SEMPRE no banco (soft-delete por timestamp)
// - Sem like/reaction visual. Reagir = mandar DM.
// =====================================================================

model Timeline {
  id          String    @id @default(cuid())
  name        String // "Geral", "Família", "Time Bessa"
  isPublic    Boolean   @default(false) // true só pra UMA timeline global do sistema
  createdById String? // FK User — null pra timeline pública do sistema
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  createdBy User?            @relation("timelinesCreated", fields: [createdById], references: [id])
  members   TimelineMember[]
  posts     TimelinePost[]

  @@index([isPublic])
  @@index([createdById])
}

model TimelineMember {
  id         String    @id @default(cuid())
  timelineId String
  userId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime  @default(now()) // pra calcular badge "não lido"
  leftAt     DateTime?
  role       String    @default("member") // "creator" | "member"

  timeline Timeline @relation(fields: [timelineId], references: [id])
  user     User     @relation("timelineMemberships", fields: [userId], references: [id])

  @@unique([timelineId, userId])
  @@index([userId, leftAt])
}

model TimelinePost {
  id            String    @id @default(cuid())
  timelineId    String
  authorId      String
  content       String? // texto (pode ser null se for só mídia)
  mediaType     String? // "photo" | "audio" | null
  mediaUrl      String? // URL no storage OU data:image/jpeg;base64,...
  mediaDuration Int? // duração em segundos (áudio)
  productCardId String? // FK Product — card de produto inline
  createdAt     DateTime  @default(now())
  editedAt      DateTime?
  deletedAt     DateTime? // soft delete pelo autor antes da meia-noite
  expiredAt     DateTime? // setado pelo cron 00:00 America/Fortaleza

  timeline    Timeline   @relation(fields: [timelineId], references: [id])
  author      User       @relation("timelinePostsAuthored", fields: [authorId], references: [id])
  productCard Product?   @relation("timelinePostProducts", fields: [productCardId], references: [id])
  reactions   Reaction[] @relation("reactionsOnPost")

  @@index([timelineId, createdAt])
  @@index([expiredAt])
  @@index([authorId, createdAt])
}

model Conversation {
  id            String   @id @default(cuid())
  type          String // "dm" | "loja"
  // Pra DM: userAId < userBId lexicograficamente
  userAId       String?
  userBId       String?
  // Pra Loja: storeId + clientUserId
  storeId       String?
  clientUserId  String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  userA      User?         @relation("conversationsAsUserA", fields: [userAId], references: [id])
  userB      User?         @relation("conversationsAsUserB", fields: [userBId], references: [id])
  store      Store?        @relation("conversationsForStore", fields: [storeId], references: [id])
  clientUser User?         @relation("conversationsAsClient", fields: [clientUserId], references: [id])
  messages   ChatMessage[]

  @@unique([userAId, userBId])
  @@unique([storeId, clientUserId])
  @@index([lastMessageAt])
}

model ChatMessage {
  id                    String    @id @default(cuid())
  conversationId        String
  senderId              String // FK User (ou User-representante-da-loja)
  senderType            String    @default("user") // "user" | "store" | "system"
  content               String?
  mediaType             String? // "photo" | "audio" | null
  mediaUrl              String?
  mediaDuration         Int?
  productCardId         String? // FK Product — card de produto inline
  readAt                DateTime? // quando o destinatário leu
  editedAt              DateTime?
  // Soft delete 3-d — NUNCA hard delete (auditoria 100%)
  deletedForSenderAt    DateTime? // remetente apagou pro lado dele
  deletedForRecipientAt DateTime? // destinatário apagou pro lado dele
  deletedForBothAt      DateTime? // remetente apagou pros dois (só se < 2h)
  createdAt             DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("chatMessagesSent", fields: [senderId], references: [id])
  productCard  Product?     @relation("chatMessageProducts", fields: [productCardId], references: [id])
  reactions    Reaction[]   @relation("reactionsOnMessage")

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([readAt])
}

// ============================================================
// REAÇÕES (👍❤️🔥) em msg de chat ou post de timeline
// ============================================================
model Reaction {
  id        String   @id @default(cuid())
  userId    String
  postId    String? // FK TimelinePost (XOR com messageId)
  messageId String? // FK ChatMessage
  emoji     String // unicode emoji (👍, ❤️, 🔥, 😂, 😢, 👏)
  createdAt DateTime @default(now())

  user    User          @relation("reactionsByUser", fields: [userId], references: [id])
  post    TimelinePost? @relation("reactionsOnPost", fields: [postId], references: [id])
  message ChatMessage?  @relation("reactionsOnMessage", fields: [messageId], references: [id])

  @@unique([userId, postId, emoji]) // 1 mesma reação por user/post
  @@unique([userId, messageId, emoji]) // 1 mesma reação por user/msg
  @@index([postId])
  @@index([messageId])
}

// ============================================================
// PUSH NOTIFICATION SUBSCRIPTIONS (Web Push API)
// ============================================================
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique // URL do push server (FCM/Mozilla/Apple)
  p256dh     String // chave pública pra criptografia
  authKey    String // chave de autenticação
  userAgent  String? // pra mostrar "Chrome iPhone" etc
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation("pushByUser", fields: [userId], references: [id])

  @@index([userId])
}

// ============================================================
// MARKETING IA — criativos gerados (fal.ai) + publicações
// ============================================================

model ProductCreative {
  id              String    @id @default(cuid())
  productId       String? // opcional: pode ser criativo avulso (sem produto do catálogo)
  brandProfileId  String? // marca do criativo (multi-tenant)
  // Dados do produto avulso (quando productId é null)
  adhocName       String? // nome do produto livre
  adhocImageUrl   String? // foto original enviada pelo usuário
  adhocCategory   String?
  adhocPrice      Float?
  adhocDesc       String?
  // Tipo do criativo
  kind            String // "editorial_photo" | "reel_video" | "transparent_photo"
  // URLs / metadados do output da fal.ai
  outputUrl       String // URL pública do asset gerado
  thumbnailUrl    String? // thumb (pra video)
  // Modelo usado pra geração
  model           String // "fal-ai/flux-pro/kontext-max" | "fal-ai/kling-video/v2.1/pro/image-to-video" | "fal-ai/bria/background/remove"
  // Prompt e parâmetros
  prompt          String?
  params          Json? // { aspect_ratio, duration, etc }
  // Custo em USD (estimado, pra controlar gasto)
  costUsd         Float?
  // Copies geradas pelo Claude pra cada plataforma
  captionIg       String?
  captionTiktok   String?
  captionWa       String?
  hashtags        String? // CSV
  // Fluxo de aprovação
  status          String    @default("pending_review") // pending_review | approved | rejected | published
  reviewedById    String? // userId do admin que revisou
  reviewedAt      DateTime?
  rejectionReason String?
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product      Product?               @relation("creativesForProduct", fields: [productId], references: [id])
  publications MarketingPublication[] @relation("publicationsForCreative")

  @@index([productId, kind])
  @@index([brandProfileId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model MarketingPublication {
  id               String    @id @default(cuid())
  creativeId       String? // FK opcional (publicação manual sem criativo IA)
  productId        String?
  // Plataforma
  platform         String // "instagram" | "tiktok" | "whatsapp_broadcast" | "facebook"
  // ID retornado pela API da plataforma (Meta media_id, TikTok post_id, etc)
  externalId       String?
  externalUrl      String? // URL pública do post
  // Conteúdo publicado
  caption          String?
  mediaUrl         String?
  // Resultado
  status           String    @default("queued") // queued | publishing | success | failed
  errorMessage     String?
  // Métricas (atualizadas em job posterior)
  metricViews      Int?
  metricLikes      Int?
  metricComments   Int?
  metricShares     Int?
  metricSaves      Int?
  metricsUpdatedAt DateTime?
  // Quem disparou
  publishedById    String?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())

  creative ProductCreative? @relation("publicationsForCreative", fields: [creativeId], references: [id])

  @@index([platform, status])
  @@index([publishedAt])
  @@index([productId])
}

// ============================================================
// BRAND PROFILE — multi-tenant pra IA de marketing
// ============================================================
// Cada conta de Instagram administrada é um BrandProfile com
// seu próprio DNA narrativo. brand-narrative-agent lê isso pra
// gerar copy/cenário alinhado a cada marca.

model BrandProfile {
  id              String  @id @default(uuid())
  slug            String  @unique // identificador url-safe: "metafardamentos"
  displayName     String // "Meta Fardamentos"
  archetype       String  @default("custom") // mass_retail | b2b_premium | institutional | personal | political | custom
  instagramHandle String? // "@metafardamentos"
  active          Boolean @default(true)
  displayOrder    Int     @default(0) // ordem de exibição no dropdown
  logoUrl         String? // URL pública da logo (PNG/SVG, preferir quadrada)

  // DNA narrativo (preenchido pelo dono via UI)
  description    String? // pitch curto da marca (1-2 linhas)
  mission        String? // propósito/missão
  audience       String? // persona-alvo
  voiceTone      Json? // { formal: 0-10, energy, technical, humor, intimacy }
  paletteHex     Json? // ["#FF6A1F", "#FF2D92"]
  fontFamily     String? // pra overlay
  contentPillars Json? // string[] - tipos de conteúdo prioritários
  hashtags       Json? // string[]
  ctaTemplates   Json? // string[] - CTAs reutilizáveis
  taboo          Json? // string[] - palavras/temas proibidos
  exampleCopy    String? // copy bem-sucedida pra IA imitar tom

  // Conexão Instagram (preencher quando conectar Graph API)
  instagramUserId String? // IG Business Account ID
  instagramToken  String? // long-lived access token
  fbPageId        String?

  // Overrides do marketingConfig (cenários/prompts próprios)
  customConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
}

// ============================================================
// APEX COMPETIÇÃO — Torneios, partidas, ranking, desafios
// Camada de competição do app esportivo (estilo CopaFácil + Playtomic).
// Reutiliza User (carteira/perfil), AthleteProfile (card), BadgeEarned
// (XP/cashback) e Transaction (movimento TenisCash). storeId = loja
// patrocinadora/sede (campo solto sem relação, mesmo padrão de Club).
// ============================================================

model Tournament {
  id        String  @id @default(cuid())
  slug      String  @unique // URL pública: /t/copa-verao-2026
  name      String
  sport     String // TENNIS | BEACH_TENNIS | PADEL | FUTSAL | VOLLEY | ...
  format    String  @default("KNOCKOUT") // KNOCKOUT | ROUND_ROBIN | GROUPS | GROUPS_KNOCKOUT
  isDoubles Boolean @default(false) // dupla (beach tennis / padel)
  status    String  @default("DRAFT") // DRAFT | OPEN | ONGOING | FINISHED | CANCELED

  ownerId String
  owner   User    @relation("tournamentOwner", fields: [ownerId], references: [id])
  storeId String? // loja Sports & Tennis patrocinadora/sede (sem relação, padrão Club)

  description String? @db.Text
  rules       String? @db.Text
  bannerUrl   String?
  city        String?
  state       String?

  startDate           DateTime?
  endDate             DateTime?
  registrationCloseAt DateTime?
  maxEntries          Int?

  // Config de TenisCash — movimento REAL de saldo é fase 2 (gated por aprovação do dono)
  entryFeeCash     Float   @default(0) // custo de inscrição em TenisCash
  prizeCash        Float   @default(0) // prêmio ao campeão em TenisCash
  prizeDescription String?

  visibility String   @default("public")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categories TournamentCategory[]
  entries    TournamentEntry[]
  matches    TournamentMatch[]
  standings  TournamentStanding[]
  posts      TournamentPost[]

  @@index([status])
  @@index([sport])
  @@index([storeId])
}

model TournamentCategory {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String // "Geral" | "Masculino A" | "Feminino B" | "Misto"
  gender       String     @default("OPEN") // M | F | MIXED | OPEN
  levelLabel   String? // A | B | C | Open | Iniciante ...
  format       String? // override do formato do torneio (senão usa o do torneio)
  pointsWin    Int        @default(3) // pontuação na liga/pontos corridos
  pointsDraw   Int        @default(1)
  pointsLoss   Int        @default(0)

  entries   TournamentEntry[]
  matches   TournamentMatch[]
  standings TournamentStanding[]

  @@index([tournamentId])
}

model TournamentEntry {
  id           String             @id @default(cuid())
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  categoryId   String
  category     TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name      String // nome de exibição: "João & Maria" | "Time Bessa"
  seed      Int? // cabeça de chave
  groupName String? // grupo na fase de grupos
  status    String   @default("CONFIRMED") // PENDING | CONFIRMED | WITHDRAWN
  entryPaid Boolean  @default(false) // pagou inscrição em TenisCash (fase 2)
  createdAt DateTime @default(now())

  members     EntryMember[]
  homeMatches TournamentMatch[]   @relation("homeEntry")
  awayMatches TournamentMatch[]   @relation("awayEntry")
  wonMatches  TournamentMatch[]   @relation("winnerEntry")
  standing    TournamentStanding?

  @@index([categoryId])
  @@index([tournamentId])
}

model EntryMember {
  id      String          @id @default(cuid())
  entryId String
  entry   TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([userId])
}

model TournamentMatch {
  id           String             @id @default(cuid())
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  categoryId   String
  category     TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  stage     String  @default("LEAGUE") // LEAGUE | GROUP | RO32 | RO16 | QUARTER | SEMI | FINAL | THIRD
  round     Int     @default(1) // rodada (pontos corridos) ou nível da chave
  groupName String? // grupo, se fase de grupos
  ordering  Int     @default(0) // ordem da partida na rodada/chave

  homeEntryId String?
  homeEntry   TournamentEntry? @relation("homeEntry", fields: [homeEntryId], references: [id])
  awayEntryId String?
  awayEntry   TournamentEntry? @relation("awayEntry", fields: [awayEntryId], references: [id])

  scheduledAt DateTime?
  location    String?

  homeScore     Int? // sets/games/gols do mandante (resumo)
  awayScore     Int?
  winnerEntryId String?
  winnerEntry   TournamentEntry? @relation("winnerEntry", fields: [winnerEntryId], references: [id])

  status    String @default("SCHEDULED") // SCHEDULED | LIVE | FINISHED | WALKOVER | CANCELED
  liveState Json? // placar ao vivo: { sets:[...], currentGame, server, ... }

  // Avanço automático na chave (mata-mata): vencedor sobe pra nextMatch no slot nextSlot
  nextMatchId   String?
  nextMatch     TournamentMatch?  @relation("bracketProgression", fields: [nextMatchId], references: [id])
  feederMatches TournamentMatch[] @relation("bracketProgression")
  nextSlot      String? // "home" | "away"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games MatchGame[]

  @@index([tournamentId])
  @@index([categoryId, round])
  @@index([status])
}

model MatchGame {
  id           String          @id @default(cuid())
  matchId      String
  match        TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  setNumber    Int // set/game/período 1,2,3...
  homeGames    Int             @default(0)
  awayGames    Int             @default(0)
  homeTiebreak Int?
  awayTiebreak Int?

  @@unique([matchId, setNumber])
}

model TournamentStanding {
  id           String             @id @default(cuid())
  tournamentId String
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  categoryId   String
  category     TournamentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  entryId      String             @unique
  entry        TournamentEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  groupName    String?

  played       Int  @default(0)
  won          Int  @default(0)
  drawn        Int  @default(0)
  lost         Int  @default(0)
  scoreFor     Int  @default(0) // sets/games/gols a favor
  scoreAgainst Int  @default(0)
  points       Int  @default(0)
  rank         Int? // posição calculada

  updatedAt DateTime @updatedAt

  @@index([categoryId, points])
}

model AthleteRating {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport        String // TENNIS | BEACH_TENNIS | PADEL ...
  rating       Float     @default(2.0) // escala 0-7 (estilo Playtomic)
  matchesCount Int       @default(0)
  wins         Int       @default(0)
  losses       Int       @default(0)
  lastMatchAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, sport])
  @@index([sport, rating])
}

model PlayChallenge {
  id           String @id @default(cuid())
  challengerId String
  challenger   User   @relation("challenger", fields: [challengerId], references: [id], onDelete: Cascade)
  challengedId String
  challenged   User   @relation("challenged", fields: [challengedId], references: [id], onDelete: Cascade)
  sport        String

  proposedAt DateTime?
  location   String?
  message    String?

  status String @default("PENDING") // PENDING | ACCEPTED | DECLINED | PLAYED | CANCELED

  // resultado do amistoso 1v1
  homeScore Int?
  awayScore Int?
  winnerId  String? // userId do vencedor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([challengedId, status])
  @@index([challengerId, status])
}

// Mural/avisos do torneio (estilo "notícias" do CopaFácil) — TEXTO only,
// sem foto/vídeo (decisão do produto). Visível na página pública /t/:slug.
model TournamentPost {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  authorId     String? // userId do organizador (sem relação forte, padrão solto)
  title        String?
  body         String     @db.Text
  pinned       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([tournamentId, createdAt])
}

// ============================================================
// PROFISSIONAL ESPORTIVO — Card público + Gestão + Cobrança
// ------------------------------------------------------------
// Wedge de entrada: o profissional (personal, professor de tênis/
// padel, fisio, nutri) ganha um PERFIL PÚBLICO ("card"), gerencia
// seus alunos e COBRA pelos serviços dentro do app.
//
// COBRAR ≠ RECEBER: por padrão (settlementMode = off_platform) o
// profissional cobra pelo app mas recebe o dinheiro na PRÓPRIA chave
// Pix/banco — fricção de adoção quase zero, não precisa trocar de PSP.
// Recebimento pela plataforma (on_platform: split + cashback TenisCash
// + antecipação) é o upsell DEPOIS que o hábito de uso se forma.
// ============================================================

model Professional {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Card público
  slug        String  @unique // /p/joao-tenis
  displayName String
  headline    String? // "Personal Trainer & Professor de Tênis"
  bio         String? @db.Text
  avatarUrl   String?
  coverUrl    String?
  category    String? // personal | tennis | padel | physio | nutri | run | other
  city        String?
  state       String?

  // Contato exibido no card
  whatsapp  String?
  instagram String?

  // Recebimento off-platform (chave Pix DELE — gera cobrança sem trocar PSP)
  pixKey     String?
  pixKeyType String? // cpf | cnpj | email | phone | random
  bankName   String?

  // Config
  published Boolean @default(false) // card visível publicamente
  verified  Boolean @default(false) // selo S&T

  // Stats denormalizadas
  clientCount Int   @default(0)
  offerCount  Int   @default(0)
  totalBilled Float @default(0)
  totalPaid   Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers          ProfessionalOffer[]
  clients         ProfessionalClient[]
  charges         Charge[]
  subscriptions   ProfessionalSubscription[]
  digitalProducts DigitalProduct[]

  // Recebimento via plataforma (split ao vivo quando ligar o PSP)
  asaasWalletId String?

  @@index([category])
  @@index([city])
  @@index([published])
}

model ProfessionalOffer {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])

  type        String // class_presential | plan_monthly | digital_product | free_lead
  title       String
  description String? @db.Text
  imageUrl    String?

  // Preço (0 = grátis / isca)
  price       Float   @default(0)
  recurrence  String? // monthly | weekly (apenas plan_monthly)
  durationMin Int? // duração da aula presencial (min)

  active  Boolean @default(true)
  visible Boolean @default(true) // aparece no card público

  soldCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges       Charge[]
  subscriptions ProfessionalSubscription[]

  @@index([professionalId])
  @@index([type])
  @@index([active])
}

model ProfessionalClient {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])

  // O aluno PODE (ou não) ser um usuário TenisCash — ficha vale mesmo sem cadastro
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  name  String
  phone String?
  email String?
  notes String?  @db.Text
  tags  String[] // ["iniciante", "tênis", "manhã"]

  status       String    @default("active") // active | inactive | lead
  totalBilled  Float     @default(0)
  totalPaid    Float     @default(0)
  lastChargeAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges       Charge[]
  subscriptions ProfessionalSubscription[]

  @@index([professionalId])
  @@index([userId])
  @@index([status])
}

model ProfessionalSubscription {
  id             String             @id @default(cuid())
  professionalId String
  professional   Professional       @relation(fields: [professionalId], references: [id])
  clientId       String
  client         ProfessionalClient @relation(fields: [clientId], references: [id])
  offerId        String?
  offer          ProfessionalOffer? @relation(fields: [offerId], references: [id])

  title       String // snapshot do nome do plano
  amount      Float
  recurrence  String   @default("monthly") // monthly | weekly
  status      String   @default("active") // active | paused | cancelled
  nextDueDate DateTime
  dayOfMonth  Int? // dia de vencimento (1-28)

  startedAt   DateTime  @default(now())
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  charges Charge[]

  @@index([professionalId])
  @@index([clientId])
  @@index([status])
  @@index([nextDueDate])
}

model Charge {
  id             String                    @id @default(cuid())
  professionalId String
  professional   Professional              @relation(fields: [professionalId], references: [id])
  clientId       String?
  client         ProfessionalClient?       @relation(fields: [clientId], references: [id])
  offerId        String?
  offer          ProfessionalOffer?        @relation(fields: [offerId], references: [id])
  subscriptionId String?
  subscription   ProfessionalSubscription? @relation(fields: [subscriptionId], references: [id])

  amount      Float
  description String

  // COBRAR ≠ RECEBER — o coração do wedge
  settlementMode String @default("off_platform") // off_platform | on_platform

  method  String? // pix | cash | card | transfer | other
  status  String    @default("pending") // pending | paid | overdue | cancelled | refunded
  dueDate DateTime?

  // Pix off-platform (BR Code gerado da chave do profissional)
  pixPayload String? @db.Text // "copia e cola" EMV
  pixQrUrl   String? // data URL do QR (opcional)

  // Confirmação de pagamento
  paidAt          DateTime?
  paidConfirmedBy String? // manual | open_finance | platform

  // On-platform (futuro): take rate + cashback TenisCash
  cashbackAmount Float?
  feeAmount      Float?

  // Página pública de pagamento: /c/<token>
  publicToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================
// SERVIÇOS — Agendamento + Marketplace + TenisCash na rede
// ------------------------------------------------------------
// Generaliza o Professional (esportivo) p/ QUALQUER prestador de
// serviço (barbearia, salão, estética, tattoo). A camada que
// faltava: AGENDA (slots/booking) + ESTABELECIMENTO (multi-pro)
// + moeda ganha/gasta no serviço (o moat vs AppBarber/Booksy).
//
// 100% ADITIVO (mesmo princípio do LiveChannel): tabelas novas,
// links pra User/Professional/Offer como String SOLTA (sem FK) →
// `prisma db push` só CRIA tabelas, zero risco nas de produção.
// FK só DENTRO do módulo novo (VenueMember → ServiceVenue).
// ============================================================

model ServiceVenue {
  id          String  @id @default(cuid())
  ownerUserId String // User dono do estabelecimento (vira admin)
  slug        String  @unique // /v/barbearia-do-ze
  name        String
  segment     String? // barbearia | salao | estetica | tattoo | other
  bio         String? @db.Text
  avatarUrl   String?
  coverUrl    String?

  // Endereço — marketplace por cidade / "perto de mim"
  address      String?
  neighborhood String?
  city         String?
  state        String?
  cep          String?
  latitude     Float?
  longitude    Float?

  whatsapp  String?
  instagram String?

  // TenisCash (moat) — regra: cliente ganha 100% (1:1) do que paga, em T$. SEM % configurável.
  givesCashback Boolean @default(true) // estabelecimento oferece TenisCash ao cliente (sim/não)
  cashbackPct   Float   @default(0) // legado, NÃO usado (a regra é 100% fixo)
  acceptsTC     Boolean @default(true) // pode pagar serviço com T$ (burn)

  // Recebimento
  pixKey        String?
  asaasWalletId String? // split on-platform (futuro)

  published Boolean @default(false)
  verified  Boolean @default(false)

  memberCount  Int   @default(0)
  totalBilled  Float @default(0)
  reviewRating Float @default(0) // média das avaliações (denormalizado)
  reviewCount  Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members VenueMember[]

  @@index([segment])
  @@index([city])
  @@index([published])
}

model VenueMember {
  id      String       @id @default(cuid())
  venueId String
  venue   ServiceVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  professionalId String // link p/ Professional existente (String solta, sem FK)
  role           String  @default("staff") // owner | manager | staff
  commissionPct  Float   @default(0) // % de comissão do barbeiro sobre serviços/produtos
  active         Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([venueId, professionalId])
  @@index([venueId])
  @@index([professionalId])
}

model ProfessionalAvailability {
  id             String  @id @default(cuid())
  professionalId String // Professional (String solta, sem FK)
  weekday        Int // 0=domingo ... 6=sábado
  startMin       Int // minutos desde 00:00 local (540 = 09:00)
  endMin         Int // 1080 = 18:00
  active         Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([professionalId, weekday])
}

model AvailabilityException {
  id             String   @id @default(cuid())
  professionalId String
  date           DateTime // dia bloqueado (data local, 00:00)
  startMin       Int? // null = dia inteiro
  endMin         Int?
  reason         String?

  createdAt DateTime @default(now())

  @@index([professionalId, date])
}

model ServiceAppointment {
  id             String  @id @default(cuid())
  venueId        String? // ServiceVenue (opcional p/ solo)
  professionalId String // Professional que executa
  offerId        String? // ProfessionalOffer (serviço)

  // Cliente: User TenisCash (ganha cashback) OU avulso
  clientUserId  String?
  clientId      String? // ProfessionalClient (ficha)
  customerName  String?
  customerPhone String?

  startAt     DateTime
  endAt       DateTime
  durationMin Int

  serviceName String
  price       Float  @default(0)
  cashbackPct Float  @default(0) // snapshot do % no momento do booking

  status String @default("booked") // booked | confirmed | done | no_show | cancelled
  source String @default("marketplace") // marketplace | venue | whatsapp | manual

  // TenisCash
  tcEarned Float   @default(0) // creditado ao cliente quando done
  tcUsed   Float   @default(0) // T$ usado como pagamento (burn)
  chargeId String? // Charge gerado p/ registro do pagamento

  reminderSentAt DateTime?
  doneAt         DateTime?
  cancelledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId, startAt])
  @@index([venueId, startAt])
  @@index([clientUserId])
  @@index([status, startAt])
}

// ----- Serviços: gestão do estabelecimento (comanda, caixa, produtos, avaliação, lista de espera) -----

model VenueProduct {
  id        String    @id @default(cuid())
  venueId   String
  name      String
  price     Float     @default(0)
  cost      Float     @default(0)
  stock     Int       @default(0)
  minStock  Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([venueId, active])
}

model Comanda {
  id              String    @id @default(cuid())
  venueId         String
  professionalId  String
  appointmentId   String?
  clientUserId    String?
  customerName    String?
  status          String    @default("open") // open | paid | cancelled
  subtotal        Float     @default(0)
  discount        Float     @default(0)
  total           Float     @default(0)
  tcUsed          Float     @default(0)
  tcEarned        Float     @default(0)
  commissionTotal Float     @default(0)
  paymentMethod   String? // cash | pix | card | tc
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items ComandaItem[]

  @@index([venueId, createdAt])
  @@index([professionalId, createdAt])
  @@index([status])
}

model ComandaItem {
  id               String  @id @default(cuid())
  comandaId        String
  comanda          Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  kind             String // service | product
  refId            String? // offerId ou productId
  name             String
  qty              Int     @default(1)
  unitPrice        Float
  total            Float
  commissionPct    Float   @default(0)
  commissionAmount Float   @default(0)

  @@index([comandaId])
}

model CashEntry {
  id             String   @id @default(cuid())
  venueId        String
  type           String // in | out
  category       String? // service | product | withdrawal | expense | other
  amount         Float
  description    String?
  method         String? // cash | pix | card | tc
  comandaId      String?
  professionalId String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([venueId, createdAt])
}

model VenueReview {
  id             String   @id @default(cuid())
  venueId        String
  professionalId String?
  appointmentId  String?  @unique
  clientUserId   String?
  customerName   String?
  rating         Int // 1..5
  comment        String?
  createdAt      DateTime @default(now())

  @@index([venueId, createdAt])
}

model AppointmentWaitlist {
  id             String    @id @default(cuid())
  venueId        String
  professionalId String?
  customerName   String
  customerPhone  String?
  date           DateTime?
  status         String    @default("waiting") // waiting | notified | converted | cancelled
  notified       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([venueId, status])
}

// ----- Paridade AppBarber: pacotes, financeiro, estoque+, marketing, clube -----

model ServicePackage {
