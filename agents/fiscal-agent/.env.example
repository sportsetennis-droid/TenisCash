# =====================================================================
# Config local do agente fiscal — cada loja tem seu próprio .env
# =====================================================================
# Cópia: copia esse arquivo pra .env e preenche os valores reais.
# NUNCA commitar .env real.
# =====================================================================

# Porta HTTP local (matriz acessa via Tailscale: http://<ip-tailscale>:PORT)
PORT=8765

# Token de autenticação compartilhado com TenisCash central (cabeçalho X-Agent-Token)
# Gerar 1 por loja com: openssl rand -hex 32
AGENT_TOKEN=trocar-por-token-32-bytes-hex

# Identificação da loja
STORE_CODE=LOJA03
CNPJ=44052617000398

# Caminho local do PFX (certificado A1) — fica só nesta máquina
PFX_PATH=C:\Chianca\NFe_Emissao003\Certificado2026.pfx
PFX_SENHA=senha-do-pfx

# CSC e ID gerados no portal SEFAZ-PB pra essa CNPJ
# (lê do C:\Chianca\ConfigCHShop.ini -> <codigo_csc> e <identificador_csc>)
CSC=preencher
CSC_ID=000001

# Ambiente SEFAZ: 'production' ou 'homologation'
ENVIRONMENT=homologation

# Numeração inicial de NFCe (controlada localmente)
NFCE_SERIE=1
NFCE_NEXT_NUMBER=1
NFE_SERIE=1
NFE_NEXT_NUMBER=1

# Dados do emitente (lê do certificado / cadastro)
COMPANY_NAME=SPORTS E TENNIS RAINHA DA BORBOREMA
FANTASY_NAME=Sports & Tennis Rainha da Borborema
IE=
STREET=
NUMBER=
NEIGHBORHOOD=
CITY=JOAO PESSOA
STATE=PB
ZIP=
CITY_CODE=2507507
PHONE=
CRT=3
