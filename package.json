    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "node-sped-nfe": "^1.2.52",
    "node-sped-pdf": "^1.0.66",
    "nodemailer": "^9.0.1",
    "opentype.js": "^1.3.4",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.15.2",
