# Gerado automaticamente pelo Railway quando adicionar PostgreSQL
DATABASE_URL=

# Trocar em produção - usar string aleatória longa
JWT_SECRET=teniscash-prod-secret-trocar-agora

# URL do frontend (deixar * para aceitar qualquer origem no início)
FRONTEND_URL=*

# Porta (Railway define automaticamente)
PORT=3000

# WhatsApp Cloud API (Meta)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ID=
META_WHATSAPP_VERIFY_TOKEN=teniscash-whatsapp-webhook-2026
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_API_VERSION=v22.0

# Opcional: template aprovado para codigo de verificacao.
# Sem template, a API tenta enviar texto livre, que so funciona dentro da janela de atendimento/teste.
META_WHATSAPP_CODE_TEMPLATE=
META_WHATSAPP_CODE_TEMPLATE_LANG=pt_BR

# Marketing IA — geração de criativos
# fal.ai (Flux Pro Kontext Max, Kling v3 Pro, Bria RMBG) → pegar em https://fal.ai/dashboard/keys
FAL_KEY=

# Anthropic Claude (já usado em outros lugares, mas marketing/copy depende)
ANTHROPIC_API_KEY=

# Instagram publisher (Meta Graph API)
# META_IG_USER_ID = ID do Instagram Business Account (não é @handle)
#   → encontrar em developers.facebook.com/tools/explorer → /{page-id}?fields=instagram_business_account
# META_IG_ACCESS_TOKEN = Page Access Token longa duração (60d) ou system user token
META_IG_USER_ID=
META_IG_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v22.0

# Disable marketing cron (útil em dev local pra não gastar fal.ai)
# DISABLE_MARKETING_CRON=1

# Fiscal (Brasil NFe) — tokens ficam por CNPJ no banco em FiscalIssuer.apiToken.
# Nada de token global aqui. Setup é feito pelo admin em /api/admin/fiscal/issuers.
# Para webhooks: configurar URL https://tenis.cash/api/admin/fiscal/webhook no painel Brasil NFe (TODO)

# TikTok Shop (Partner API v202309 — portal GLOBAL, cobre o Brasil)
# Criar App em https://partner.tiktokshop.com → pega App Key, App Secret, Service ID.
# Configurar a Redirect URL do app = TIKTOK_SHOP_REDIRECT_URI abaixo.
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_REDIRECT_URI=https://teniscash.com.br/api/tiktok-shop/oauth/callback
# Pega via GET /api/admin/tiktok-shop/warehouses depois de conectar a loja:
TIKTOK_SHOP_WAREHOUSE_ID=
# Opcionais (têm default no código):
# TIKTOK_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
# TIKTOK_SHOP_AUTH_BASE=https://auth.tiktok-shops.com
# TIKTOK_SHOP_DEFAULT_WEIGHT_KG=0.6
