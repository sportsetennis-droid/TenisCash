// =====================================================================
// APEX SPORT — Schema Prisma core (não roda ainda — falta cluster)
// =====================================================================
// Postgres + PostGIS pra geometria. Activity samples vão pra ClickHouse
// (não definido aqui — fica em outro schema/store).
// =====================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.apex-prisma-client"
}

datasource db {
  provider   = "postgresql"
  url        = env("APEX_DATABASE_URL")
  extensions = [postgis]
}

// ==================== IDENTIDADE ====================

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String   @unique
  displayName String?
  avatarUrl   String?
  locale      String   @default("pt-BR")
  status      String   @default("active") // active | suspended | deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  athleteProfile    AthleteProfile?
  deviceConnections DeviceConnection[]
  activities        Activity[]
  routes            Route[]
  segmentEfforts    SegmentEffort[]
  clubMemberships   ClubMembership[]
  challengeParticipations ChallengeParticipation[]
  userPlans         UserPlan[]
  safetyContacts    SafetyContact[]
  badges            BadgeEarned[]
  consents          Consent[]

  @@index([status])
}

model AthleteProfile {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals           Json?    // {target_distance, target_race, ...}
  experienceLevel String?  // beginner | intermediate | advanced
  zones           Json?    // HR zones, pace zones, power zones
  privacyDefaults Json?    // visibility default por tipo de atividade
  birthYear       Int?
  weightKg        Float?
  heightCm        Float?
  sex             String?  // M | F | NB | UNSPECIFIED
  updatedAt       DateTime @updatedAt
}

model Consent {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope         String   // health_data, location_history, heatmap_optin, marketing, ...
  granted       Boolean
  version       String
  grantedAt     DateTime @default(now())
  revokedAt     DateTime?

  @@index([userId, scope])
}

model DeviceConnection {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String   // apple_health, health_connect, garmin, polar, oura, whoop
  externalUserId  String
  accessTokenRef  String?  // referencia pro vault, NÃO o token em si
  refreshTokenRef String?
  scopes          String[]
  status          String   @default("active")
  connectedAt     DateTime @default(now())
  lastSyncAt      DateTime?

  @@unique([provider, externalUserId])
  @@index([userId])
}

// ==================== ATIVIDADES ====================

model Activity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  sportType       String   // RUN, RIDE, SWIM, WALK, HIKE, TRAIL, STRENGTH, YOGA, ...
  startedAt       DateTime
  endedAt         DateTime?
  elapsedTimeS    Int
  movingTimeS     Int
  distanceM       Float?
  elevationGainM  Float?
  elevationLossM  Float?
  avgHeartRate    Int?
  maxHeartRate    Int?
  avgPace         Float?   // sec/km
  maxSpeed        Float?   // m/s
  avgPower        Float?   // watts (ciclismo)
  calories        Int?
  trainingLoad    Float?
  hrTSS           Float?

  // Foto principal + extras vão pra ActivityPhoto
  // Samples (GPS, HR, etc.) vão pra ClickHouse — NÃO armazenamos polyline gigante aqui
  summaryPolyline String?  @db.Text // versão simplificada pra display

  visibility      String   @default("followers") // public | followers | clubs | private
  deviceSource    String?  // phone, apple_watch, garmin_fenix, etc.
  rawPayloadRef   String?  // referência pra FIT/GPX original em S3

  // Privacidade
  startPrivacyRadiusM Int @default(250)
  endPrivacyRadiusM   Int @default(250)

  // Status
  processingState String   @default("pending") // pending | processing | done | failed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  laps             ActivityLap[]
  photos           ActivityPhoto[]
  segmentEfforts   SegmentEffort[]
  liveTrackingSessions LiveTrackingSession[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([sportType, startedAt])
}

model ActivityLap {
  id           String   @id @default(cuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  lapNumber    Int
  startedAt    DateTime
  elapsedTimeS Int
  distanceM    Float?
  avgPace      Float?
  avgHeartRate Int?
}

model ActivityPhoto {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  imageUrl   String
  takenAt    DateTime?
  // Lat/Lng se tiver — privacidade aplicada
  latitude   Float?
  longitude  Float?
}

// ==================== ROTAS ====================

model Route {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id])
  name         String
  sportType    String
  distanceM    Float
  elevationGainM Float
  polyline     String   @db.Text // encoded polyline
  // Geom seria PostGIS — gerenciado por raw SQL ou Prisma postgis extension
  visibility   String   @default("public")
  source       String?  // imported_gpx | created | suggested
  createdAt    DateTime @default(now())

  routePoints RoutePoint[]

  @@index([ownerId])
  @@index([sportType])
}

model RoutePoint {
  id          String   @id @default(cuid())
  routeId     String
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sequence    Int
  latitude    Float
  longitude   Float
  altitudeM   Float?

  @@unique([routeId, sequence])
}

// ==================== SEGMENTOS ====================

model Segment {
  id              String   @id @default(cuid())
  name            String
  sportType       String
  polyline        String   @db.Text
  distanceM       Float
  elevationGainM  Float
  visibility      String   @default("public")
  verificationState String @default("auto") // auto | community | reviewed | rejected
  geomHash        String?  // hash da geometria pra dedup
  createdAt       DateTime @default(now())

  efforts SegmentEffort[]

  @@index([sportType])
  @@index([geomHash])
}

model SegmentEffort {
  id          String   @id @default(cuid())
  segmentId   String
  segment     Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  athleteId   String
  athlete     User     @relation(fields: [athleteId], references: [id])
  elapsedMs   Int      // tempo em ms
  startedAt   DateTime
  avgHeartRate Int?
  avgPower    Float?
  rankType    String   @default("user") // user | club | local | global
  flaggedFraud Boolean @default(false)

  @@index([segmentId, elapsedMs])
  @@index([athleteId])
}

// ==================== CLUBES & DESAFIOS ====================

model Club {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?  @db.Text
  sportScope  String?  // all | running | cycling | ...
  privacyLevel String  @default("public") // public | private | invite_only
  city        String?
  state       String?
  country     String   @default("BR")
  createdAt   DateTime @default(now())

  memberships ClubMembership[]

  @@index([city])
  @@index([sportScope])
}

model ClubMembership {
  id       String   @id @default(cuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member") // owner | admin | member
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
}

model Challenge {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  ruleType    String   // distance | time | elevation | streak | social
  ruleConfig  Json     // { target_distance_m, target_streak_days, ... }
  startsAt    DateTime
  endsAt      DateTime
  prizeType   String?  // badge | premium_month | merch | nft
  sponsorId   String?
  visibility  String   @default("public")
  createdAt   DateTime @default(now())

  participations ChallengeParticipation[]
}

model ChallengeParticipation {
  id            String   @id @default(cuid())
  challengeId   String
  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressValue Float    @default(0) // depende do ruleType
  completedAt   DateTime?
  joinedAt      DateTime @default(now())

  @@unique([challengeId, userId])
}

// ==================== COACHING ====================

model TrainingPlan {
  id              String   @id @default(cuid())
  goalType        String   // 5k, 10k, 21k, 42k, custom
  level           String   // beginner | intermediate | advanced
  durationWeeks   Int
  authorId        String?
  version         String   @default("1.0")
  isOfficial      Boolean  @default(false)
  createdAt       DateTime @default(now())

  workouts Workout[]
  userPlans UserPlan[]
}

model Workout {
  id           String   @id @default(cuid())
  planId       String
  plan         TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekNumber   Int
  dayOfWeek    Int      // 1-7
  workoutType  String   // easy | tempo | intervals | long | rest | cross
  targetDistanceM Float?
  targetDurationS Int?
  description  String?  @db.Text

  steps WorkoutStep[]
}

model WorkoutStep {
  id          String   @id @default(cuid())
  workoutId   String
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sequence    Int
  stepType    String   // warmup | main | recovery | cooldown
  durationS   Int?
  distanceM   Float?
  targetZone  String?  // Z1 | Z2 | Z3 | Z4 | Z5
  repetitions Int?

  @@unique([workoutId, sequence])
}

model UserPlan {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String
  plan            TrainingPlan @relation(fields: [planId], references: [id])
  startedAt       DateTime
  endsAt          DateTime
  status          String   @default("active") // active | completed | abandoned
  adherenceScore  Float?   // 0-100 % de aderência
}

// ==================== SEGURANÇA / LIVE TRACKING ====================

model SafetyContact {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  relationship String?
  notifyOnLive Boolean @default(true)
  notifyOnDistress Boolean @default(true)
}

model LiveTrackingSession {
  id           String   @id @default(cuid())
  activityId   String
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  shareTokenHash String @unique // hash do token, NÃO o token cru
  startedAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  viewerCount  Int      @default(0)

  @@index([expiresAt])
}

// ==================== GAMIFICAÇÃO ====================

model BadgeEarned {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey  String   // "5k_club", "marathon", "100km_month", ...
  earnedAt  DateTime @default(now())
  xpAwarded Int      @default(0)
  metadata  Json?

  @@unique([userId, badgeKey])
}

// ==================== BILLING ====================

model BillingSubscription {
  id              String   @id @default(cuid())
  userId          String
  provider        String   // apple_iap | google_play | stripe | mercado_pago
  storeSku        String   // pro_monthly | elite_yearly | ...
  entitlement     String   // free | pro | elite | teams
  renewalState    String   @default("active") // active | grace | canceled | expired
  currentPeriodEnd DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([provider, storeSku])
}
