logLevel: info
logDestinations: [file]
logFile: C:/TenisCash/CameraAgent/mediamtx.log

api: true
apiAddress: 127.0.0.1:9997

playback: true
playbackAddress: :9996
playbackAllowOrigins:
  - https://teniscash.com.br
  - https://www.teniscash.com.br

hls: true
hlsAddress: :8888
hlsAllowOrigins:
  - https://teniscash.com.br
  - https://www.teniscash.com.br
hlsAlwaysRemux: true
hlsVariant: fmp4
hlsSegmentCount: 8
hlsSegmentDuration: 1s
hlsSegmentMaxSize: 50M

rtmp: false
webrtc: false
srt: false

pathDefaults:
  sourceOnDemand: false
  rtspTransport: tcp
  # TC60 audio and video timestamps drift apart. Recording is handled by
  # FFmpeg video-copy so the original Full HD image is kept without cuts.
  record: false

